<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.livedeck.LiveDeck</id>
  <name>LiveDeck</name>
  <summary>Couch-first, controller-only Twitch client (unofficial)</summary>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>GPL-3.0-only</project_license>
  <developer id="io.github.lelandp"><name>LelandP</name></developer>
  <url type="homepage">https://github.com/LelandP/livedeck</url>
  <description>
    <p>LiveDeck is an unofficial Twitch client made for a TV and a controller, such as SteamOS Game Mode on the Steam Deck. Browse live streams and categories, watch with chat, and sign in with a code to see who you follow and write in chat.</p>
    <p>LiveDeck is not affiliated with Twitch or Valve. Streams are found with Streamlink through unofficial endpoints, which can break and may conflict with Twitch's terms of service.</p>
  </description>
  <launchable type="desktop-id">io.github.livedeck.LiveDeck.desktop</launchable>
  <categories>
    <category>AudioVideo</category>
    <category>Video</category>
  </categories>
  <supports>
    <control>gamepad</control>
    <control>keyboard</control>
  </supports>
  <screenshots>
    <screenshot type="default">
      <image>https://raw.githubusercontent.com/LelandP/livedeck/main/assets/livedeck.png</image>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1">
    <content_attribute id="social-chat">intense</content_attribute>
  </content_rating>
  <!-- No <releases> here: the Flatpak workflow adds one with the version from Cargo.toml. -->
</component>
