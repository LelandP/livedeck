// Atkinson Hyperlegible (SIL OFL 1.1, assets/fonts/): designed for legibility at a distance.
// Importing a font file registers it, so it works without being installed on the system.
import "../../../assets/fonts/AtkinsonHyperlegible-Regular.ttf";
import "../../../assets/fonts/AtkinsonHyperlegible-Bold.ttf";
import { Theme } from "theme.slint";
import { StreamItem, MosaicCell, RowData, ChatMsg, ChatPiece, SearchKey, ToastItem, MvTile, MvLayoutChip, MvStripItem, PopupItem } from "types.slint";
import { Hint, Toast } from "components.slint";
import { ViewIcon } from "icons.slint";
import { HomeContent } from "home.slint";
import { GridContent } from "grid.slint";
import { SearchContent } from "search.slint";
import { Rail } from "rail.slint";
import { PlayerScreen } from "player.slint";
import { SignInScreen } from "signin.slint";
import { SettingsScreen } from "settings.slint";
import { MultiviewScreen, ViewPopup, FullScreenStrip } from "multiview.slint";

export { StreamItem, MosaicCell, RowData, ChatMsg, ChatPiece, SearchKey, ToastItem, MvTile, MvLayoutChip, MvStripItem, PopupItem }

// Hint-bar actions (mouse fallback). Rust maps them to core Intents.
export enum UiAction { select, back, toggle-chat, menu, retry, page-right, view }

// Pure view of `htpc_core::AppState`. Rust (crates/ui/src/view_model.rs) sets every property.
// Navigation logic lives in `htpc_core::reduce`. This file only renders and animates.
export component MainWindow inherits Window {
    title: "LiveDeck";
    // Title bar and taskbar icon (made by packaging/windows/make-icon.ps1).
    icon: @image-url("../../../assets/livedeck.png");
    preferred-width: 1280px;
    preferred-height: 800px;
    background: Theme.bg;
    default-font-family: Theme.font;

    in property <[RowData]> rows;
    in property <[ChatMsg]> chat;
    in property <string> user-name: "";
    in property <string> device-code: "";
    in property <string> verification-url: "";
    // Under the code on the sign-in screen: waiting, or why the login ended. `login-failed` turns
    // A into "New code".
    in property <string> login-status: "";
    in property <bool> login-failed: false;
    // The QR code of the verification link (one pixel per module, drawn pixelated).
    in property <image> qr;
    // What to say about an empty feed.
    in property <string> empty-text: "";

    // Heading of the feed screens, and what to say when a feed failed or is empty.
    in property <string> heading: "";
    in property <string> feed-error: "";
    in property <bool> feed-empty: false;
    // What A does on the focused card ("Watch" / "Open"), and whether X / B have something to do.
    in property <string> select-label: "Watch";
    in property <bool> can-retry: false;
    in property <bool> can-back: false;
    // A stream or channel card has focus: View opens its popup, which the hint calls `view-label`
    // ("Multiview" on a live stream, "Favorites" on an offline channel).
    in property <bool> can-view: false;
    in property <string> view-label: "Multiview";
    // The multiview tray on browse screens ("Multiview · 3 picked"). Empty: hidden.
    in property <string> tray-text: "";

    // Settings screen: the focused row, and the current value of each choice.
    in property <int> settings-focus: 0;
    in property <string> chat-layout-label: "";
    in property <string> quality-label: "";
    in property <string> live-notifications-label: "";
    in property <string> background-play-label: "";
    in property <string> show-kick-label: "";
    // "<channel> is live" popups, newest first (at most three), and how many more there are.
    in property <[ToastItem]> toasts;
    in property <int> toast-more: 0;
    // The app version for the about text (set by the app from its Cargo version).
    in property <string> version: "";

    // 0 = home / following / favorites, 1 = player, 2 = sign in, 3 = grid: browse / category, 4 = settings,
    // 5 = search, 6 = multiview's grid (ScreenId in view_model.rs)
    in property <int> screen: 0;
    in property <int> sel-row: 0;
    in property <int> sel-col: 0;
    // Home, Following and Search: the column each row is scrolled to (view_model.rs `row_cols`).
    in property <[int]> row-cols;

    // Search: the text, the keyboard (set once) and its focused key, where focus is, and what to
    // say while there are no results.
    in property <string> search-query: "";
    in property <[SearchKey]> search-keys;
    in property <int> search-key-focus: 0;
    in property <bool> search-on-keys: false;
    in property <bool> search-in-results: false;
    in property <string> search-status: "";
    // Rail cursor: 0..5 nav entries, 6 = account (RailEntry order in htpc-core).
    in property <int> rail-index: 0;
    in property <bool> rail-focused: false;
    // Rail entry shown as the current destination.
    in property <int> rail-current: 0;
    in property <bool> chat-open: false;
    // Chat as an overlay on the video instead of a side panel, and its connection state.
    in property <bool> chat-overlay: false;
    in property <string> chat-status: "";
    in property <StreamItem> now-playing;

    // Player screen. `video` is the latest mpv frame of slot `video-slot` (the stream with sound),
    // set on the UI thread by `htpc_ui::show_video`.
    in-out property <image> video;
    in property <int> video-slot: 0;
    // Every slot's latest frame, by slot, for multiview's tiles and strip (`htpc_ui::show_video`).
    in-out property <[image]> tile-videos;

    // Multiview runs (the grid, or full screen with the others behind it): its places, the
    // layout chips, "3 streams", and for full screen "2 of 3 in multiview" and the strip.
    in property <bool> mv-active: false;
    in property <[MvTile]> mv-tiles;
    in property <[MvLayoutChip]> mv-layouts;
    in property <string> mv-count-text: "";
    in property <int> mv-count: 0;
    in property <string> mv-position: "";
    in property <[MvStripItem]> mv-strip;
    // The picker panel in the grid: tab (0 Favorites, 1 Following), rows, which are already
    // watched and which are starred, the focused row, what to say when there are none, and what
    // Y does ("Star" / "Unstar", empty with no rows).
    in property <bool> picker-open: false;
    in property <int> picker-tab: 1;
    in property <[StreamItem]> picker-items;
    in property <[bool]> picker-watching;
    in property <[bool]> picker-starred;
    in property <int> picker-focus: 0;
    in property <string> picker-empty: "";
    in property <string> picker-star-label: "";
    // The View popup, over any screen. `popup-on-layout`: the focused row is the layout (◀ ▶).
    in property <bool> popup-open: false;
    in property <string> popup-title: "";
    in property <string> popup-sub: "";
    in property <[PopupItem]> popup-rows;
    in property <int> popup-focus: 0;
    in property <bool> popup-on-layout: false;
    // The grid's tile area: 1152 px wide from x = 64 at 1280 px, centred in a wider window, and
    // scaled down (`mv-k`) to make room for the chat panel. Rust reads them to size each tile's
    // video (`htpc_ui::video_size`).
    out property <length> mv-area-x: root.chat-open ? Theme.safe-x / 2 : (root.width - Theme.mv-area-w) / 2;
    out property <length> mv-area-w: root.chat-open ? root.width - Theme.chat-w - Theme.safe-x : Theme.mv-area-w;
    property <float> mv-base-k: min(1.0, root.mv-area-w / Theme.mv-area-w);
    // The grid with nothing pressed for `mv-idle-after` and nothing open over it: the header,
    // hints and captions fade, and the tiles grow to fill the window (beside the chat panel when
    // it is open), keeping their shape. Any button brings it all back.
    out property <bool> mv-idle: root.screen == 6 && !root.hud-visible && !root.picker-open && !root.popup-open && !root.raid-open && !root.exit-prompt && !root.sleep-warning;
    property <length> mv-free-w: root.width - (root.chat-open ? Theme.chat-w : 0px) - 2 * Theme.mv-idle-margin;
    property <length> mv-free-h: root.height - 2 * Theme.mv-idle-margin;
    out property <float> mv-k: root.mv-idle ? min(root.mv-free-w / Theme.mv-area-w, root.mv-free-h / Theme.mv-area-h) : root.mv-base-k;
    // Where the tile area's top left is drawn.
    property <length> mv-grid-x: root.mv-idle ? Theme.mv-idle-margin + (root.mv-free-w - Theme.mv-area-w * root.mv-k) / 2 : root.mv-area-x + (root.mv-area-w - Theme.mv-area-w * root.mv-k) / 2;
    property <length> mv-grid-y: root.mv-idle ? (root.height - Theme.mv-area-h * root.mv-k) / 2 : (root.height - 800px) / 2 + Theme.mv-area-y + (Theme.mv-area-h - Theme.mv-area-h * root.mv-k) / 2;
    // The strip over multiview's full screen is up (for 2.6 s after LB/RB or going full screen):
    // its thumbnails need frames, so their players render at thumbnail size meanwhile.
    property <bool> strip-shown: false;
    out property <bool> mv-strip-visible: root.strip-shown && root.screen == 1 && root.mv-active;
    changed video-slot => {
        if (root.screen == 1 && root.mv-active) {
            root.show-strip();
        }
    }
    strip-timer := Timer {
        interval: 2600ms;
        running: root.strip-shown;
        triggered => { root.strip-shown = false; }
    }
    function show-strip() {
        root.strip-shown = true;
        strip-timer.restart();
    }
    // 0 loading, 1 playing, 2 offline, 3 failed (PlaybackId in view_model.rs).
    in property <int> playback: 0;
    in property <string> playback-error: "";
    // What the player logged before failing (shown small under the error, for bug reports).
    in property <string> playback-details: "";
    in property <bool> paused: false;
    // The player menu (Start while watching): open, focused row, and each row's value.
    in property <bool> player-menu-open: false;
    in property <int> player-menu-focus: 0;
    in property <[string]> player-menu-values: [];
    // The stream plays sound only: the black audio-only screen, and a locked Quality row.
    in property <bool> audio-only: false;
    // The stats box over the video, one fact per line. Empty while it is off.
    in property <string> stats-text: "";
    // Changes whenever the HUD should come back. It fades out again after `hud-timeout`.
    in property <int> hud-pulse: 0;
    // The "Quit LiveDeck?" prompt (B on a root screen). A quits, B cancels.
    in property <bool> exit-prompt: false;
    // The sleep timer in the player's HUD ("Sleep in 42 min"), and its "Still watching?" card,
    // during which any button only keeps going.
    in property <string> sleep-label: "";
    in property <bool> sleep-warning: false;
    // The subscribe card over the stream (player menu): the QR code of the channel's subscribe
    // page, its address, and whether A opens it in a browser (never in Game Mode).
    in property <bool> subscribe-open: false;
    in property <image> subscribe-qr;
    in property <string> subscribe-url: "";
    in property <bool> subscribe-can-open: false;
    // The raid card over the stream (the channel on screen raided another one): A goes now, B
    // stays, and it follows by itself when the countdown ends.
    in property <bool> raid-open: false;
    in property <string> raid-title: "";
    in property <string> raid-viewers: "";
    in property <int> raid-seconds: 0;
    // The hype train bar at the top of the video, while a train runs in the channel on screen.
    in property <bool> hype-open: false;
    in property <int> hype-level: 0;
    in property <int> hype-permille: 0;
    in property <string> hype-points: "";
    in property <int> hype-seconds: 0;
    // Writing in chat over the stream (see player.slint's PlayerScreen).
    in property <bool> compose-open: false;
    in property <bool> compose-needs-sign-in: false;
    in property <string> compose-text: "";
    in property <string> compose-count: "";
    in property <[SearchKey]> compose-keys;
    in property <int> compose-key-focus: 0;
    in property <int> compose-shift: 0;
    in property <[string]> compose-chips;
    in property <int> compose-chip-focus: -1;
    in property <string> compose-status: "";
    in property <bool> compose-problem: false;
    in property <string> room-mode: "";
    in property <string> compose-hint: "";
    // The area mpv renders into (logical px). Rust multiplies by the scale factor. Not animated
    // with the chat slide, so the texture is allocated once per layout change. In the side
    // layout the chat keyboard takes the bottom of the video's strip.
    out property <length> video-w: root.width - (root.chat-open && !root.chat-overlay ? Theme.chat-w : 0px);
    out property <length> video-h: root.height - (root.compose-open && !root.chat-overlay ? Theme.compose-h + Theme.hints-h : 0px);
    property <bool> hud-visible: true;

    // The window size in logical px. The layout is drawn for 1280x800 (theme.slint), so Rust picks
    // the scale factor that fits it to the window (`htpc_ui::fit_scale`) whenever the size changes,
    // instead of trusting the system's DPI guess (about 2x on the Deck's small, dense screen).
    out property <length> window-w: root.width;
    out property <length> window-h: root.height;
    callback geometry-changed();
    changed width => { root.geometry-changed(); }
    changed height => { root.geometry-changed(); }

    changed hud-pulse => {
        root.hud-visible = true;
        hud-timer.restart();
    }
    changed screen => {
        root.hud-visible = true;
        hud-timer.restart();
        if (root.screen == 1 && root.mv-active) {
            root.show-strip();
        } else {
            root.strip-shown = false;
        }
    }
    // The player's HUD, and multiview's grid controls (`mv-idle`).
    hud-timer := Timer {
        interval: root.screen == 6 ? Theme.mv-idle-after : 4s;
        running: root.screen == 1 || root.screen == 6;
        triggered => { root.hud-visible = false; }
    }

    // Raw key text (Slint key codes). Returns true if Rust handled it.
    callback key(string) -> bool;
    // Mouse fallbacks.
    callback card-clicked(int, int);
    callback rail-clicked(int);
    callback action(UiAction);

    // Order must match `htpc_core::RailEntry`. The account entry is appended by Rail.
    property <[string]> rail-items: ["Home", "Following", "Favorites", "Browse", "Search", "Settings"];

    // Controller first. Keyboard stand-in: arrows, Enter = A, Esc/Backspace = B, Y = chat. On
    // Search, typed characters and Backspace edit the text instead.
    // Mouse is a fallback only: clicks act, hover never moves controller focus.
    FocusScope {
        init => { self.focus(); }
        key-pressed(e) => {
            // Leave shortcuts such as Alt+F4 to the system.
            if (e.modifiers.control || e.modifiers.alt || e.modifiers.meta) {
                return reject;
            }
            if (root.key(e.text)) {
                return accept;
            }
            return reject;
        }
    }

    // Every child shorter than the window sets `y: 0px`: without it Slint centres it vertically,
    // which pushed these 36 px down, under the hints bar.
    if root.screen == 0 : HomeContent {
        x: Theme.rail-collapsed;
        y: 0px;
        width: parent.width - Theme.rail-collapsed;
        height: parent.height - Theme.hints-h;
        rows: root.rows;
        sel-row: root.sel-row;
        sel-col: root.sel-col;
        row-cols: root.row-cols;
        active: !root.rail-focused;
        heading: root.heading;
        picked(r, c) => { root.card-clicked(r, c); }
    }

    if root.screen == 3 : GridContent {
        x: Theme.rail-collapsed;
        y: 0px;
        width: parent.width - Theme.rail-collapsed;
        height: parent.height - Theme.hints-h;
        rows: root.rows;
        sel-row: root.sel-row;
        sel-col: root.sel-col;
        active: !root.rail-focused;
        heading: root.heading;
        picked(r, c) => { root.card-clicked(r, c); }
    }

    if root.screen == 5 : SearchContent {
        x: Theme.rail-collapsed;
        y: 0px;
        width: parent.width - Theme.rail-collapsed;
        height: parent.height - Theme.hints-h;
        rows: root.rows;
        sel-row: root.sel-row;
        sel-col: root.sel-col;
        row-cols: root.row-cols;
        query: root.search-query;
        keys: root.search-keys;
        key-focus: root.search-key-focus;
        on-keys: root.search-on-keys;
        in-results: root.search-in-results;
        status: root.search-status;
        picked(r, c) => { root.card-clicked(r, c); }
    }

    // A feed that failed to load, or loaded nothing. Cards already on screen stay visible above it.
    if (root.screen == 0 || root.screen == 3) && (root.feed-error != "" || root.feed-empty) : Rectangle {
        x: Theme.rail-collapsed;
        y: parent.height - Theme.hints-h - 96px;
        width: parent.width - Theme.rail-collapsed;
        height: 96px;
        background: Theme.surface;

        VerticalLayout {
            alignment: center;
            padding-left: Theme.safe-x;
            padding-right: Theme.safe-x;
            spacing: 4px;
            Text {
                text: root.feed-error != "" ? "Could not load" : root.empty-text;
                color: Theme.text;
                font-size: Theme.fs-body;
                font-weight: 800;
            }
            Text {
                visible: root.feed-error != "";
                text: root.feed-error + "  ·  Press X to retry";
                color: Theme.muted;
                font-size: Theme.fs-small;
                overflow: elide;
            }
        }
    }

    if root.screen == 2 : SignInScreen {
        x: Theme.rail-collapsed;
        width: parent.width - Theme.rail-collapsed;
        height: parent.height;
        code: root.device-code;
        url: root.verification-url;
        status: root.login-status;
        failed: root.login-failed;
        qr: root.qr;
    }

    if root.screen == 4 : SettingsScreen {
        x: Theme.rail-collapsed;
        width: parent.width - Theme.rail-collapsed;
        height: parent.height;
        user-name: root.user-name;
        chat-layout: root.chat-layout-label;
        quality: root.quality-label;
        live-notifications: root.live-notifications-label;
        background-play: root.background-play-label;
        show-kick: root.show-kick-label;
        version: root.version;
        focus-row: root.rail-focused ? -1 : root.settings-focus;
    }

    // After every screen it sits beside: Slint paints in declaration order, and the expanded rail
    // must draw over the screen content, not under it.
    if root.screen == 0 || root.screen == 2 || root.screen == 3 || root.screen == 4 || root.screen == 5 : Rail {
        x: 0px;
        y: 0px;
        height: parent.height - Theme.hints-h;
        items: root.rail-items;
        selected: root.rail-index;
        current: root.rail-current;
        expanded: root.rail-focused;
        user-name: root.user-name;
        activated(i) => { root.rail-clicked(i); }
    }

    if root.screen == 1 : PlayerScreen {
        width: parent.width;
        height: parent.height;
        stream: root.now-playing;
        chat: root.chat;
        chat-open: root.chat-open;
        chat-overlay: root.chat-overlay;
        chat-status: root.chat-status;
        video: root.video;
        playback: root.playback;
        playback-error: root.playback-error;
        playback-details: root.playback-details;
        paused: root.paused;
        hud-visible: root.hud-visible;
        menu-open: root.player-menu-open;
        menu-focus: root.player-menu-focus;
        menu-values: root.player-menu-values;
        audio-only: root.audio-only;
        stats-text: root.stats-text;
        sleep-label: root.sleep-label;
        subscribe-open: root.subscribe-open;
        subscribe-qr: root.subscribe-qr;
        subscribe-url: root.subscribe-url;
        subscribe-can-open: root.subscribe-can-open;
        raid-open: root.raid-open;
        raid-title: root.raid-title;
        raid-viewers: root.raid-viewers;
        raid-seconds: root.raid-seconds;
        hype-open: root.hype-open;
        hype-level: root.hype-level;
        hype-permille: root.hype-permille;
        hype-points: root.hype-points;
        hype-seconds: root.hype-seconds;
        compose-open: root.compose-open;
        compose-needs-sign-in: root.compose-needs-sign-in;
        compose-text: root.compose-text;
        compose-count: root.compose-count;
        compose-keys: root.compose-keys;
        compose-key-focus: root.compose-key-focus;
        compose-shift: root.compose-shift;
        compose-chips: root.compose-chips;
        compose-chip-focus: root.compose-chip-focus;
        compose-status: root.compose-status;
        compose-problem: root.compose-problem;
        room-mode: root.room-mode;
        compose-hint: root.compose-hint;
    }

    if root.screen == 6 : MultiviewScreen {
        width: parent.width;
        height: parent.height;
        tiles: root.mv-tiles;
        tile-videos: root.tile-videos;
        layouts: root.mv-layouts;
        count-text: root.mv-count-text;
        k: root.mv-k;
        grid-x: root.mv-grid-x;
        grid-y: root.mv-grid-y;
        header-x: root.mv-area-x + (root.mv-area-w - Theme.mv-area-w * root.mv-base-k) / 2;
        header-w: Theme.mv-area-w * root.mv-base-k;
        idle: root.mv-idle;
        chat: root.chat;
        chat-open: root.chat-open;
        chat-status: root.chat-status;
        raid-open: root.raid-open;
        raid-title: root.raid-title;
        raid-viewers: root.raid-viewers;
        raid-seconds: root.raid-seconds;
        picker-open: root.picker-open;
        picker-tab: root.picker-tab;
        picker-items: root.picker-items;
        picker-watching: root.picker-watching;
        picker-starred: root.picker-starred;
        picker-focus: root.picker-focus;
        picker-empty: root.picker-empty;
    }

    // Multiview's full screen: which stream and the strip of all of them, for a moment after
    // LB/RB. Kept out of the way of the player's own cards and menus.
    if root.screen == 1 && root.mv-active : FullScreenStrip {
        width: parent.width;
        height: parent.height;
        stream: root.now-playing;
        position: root.mv-position;
        items: root.mv-strip;
        tile-videos: root.tile-videos;
        shown: root.strip-shown && !root.player-menu-open && !root.compose-open && !root.subscribe-open && !root.raid-open && !root.popup-open;
    }

    // The streams picked for multiview, in the bottom right corner of the browse screens. View on
    // any live card starts them from its popup; a click on the tray is View.
    if (root.screen == 0 || root.screen == 3 || root.screen == 5) && root.tray-text != "" : Rectangle {
        x: parent.width - self.width - Theme.safe-x;
        y: parent.height - Theme.hints-h - self.height - 16px;
        width: tray-row.preferred-width + 28px;
        height: 48px;
        border-radius: 24px;
        border-width: 2px;
        border-color: Theme.accent;
        background: #18181bf2;
        TouchArea { clicked => { root.action(UiAction.view); } }
        tray-row := HorizontalLayout {
            x: 14px;
            width: self.preferred-width;
            spacing: 10px;
            alignment: start;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 40px;
                height: 26px;
                border-radius: 13px;
                border-width: 2px;
                border-color: Theme.text;
                ViewIcon {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 14px;
                    height: 14px;
                }
            }
            Text {
                text: root.tray-text;
                color: Theme.text;
                font-size: Theme.fs-small;
                font-weight: 700;
                vertical-alignment: center;
            }
        }
    }

    // The View popup, over any screen.
    if root.popup-open : ViewPopup {
        width: parent.width;
        height: parent.height;
        title: root.popup-title;
        sub: root.popup-sub;
        rows: root.popup-rows;
        focused-row: root.popup-focus;
    }

    // The quit prompt, over everything but the hints bar. The scrim swallows clicks so nothing
    // underneath reacts while it is open.
    if root.exit-prompt : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000b8;
        TouchArea { }

        Rectangle {
            width: 560px;
            height: 240px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - Theme.hints-h - self.height) / 2;
            border-radius: 12px;
            border-width: 2px;
            border-color: Theme.surface-high;
            background: Theme.surface;

            VerticalLayout {
                alignment: center;
                padding: 40px;
                spacing: 32px;
                Text {
                    text: "Quit LiveDeck?";
                    color: Theme.text;
                    font-size: Theme.fs-display;
                    font-weight: 800;
                    horizontal-alignment: center;
                }
                HorizontalLayout {
                    alignment: center;
                    spacing: 56px;
                    Hint { glyph: "A"; label: "Quit"; clicked => { root.action(UiAction.select); } }
                    Hint { glyph: "B"; label: "Cancel"; clicked => { root.action(UiAction.back); } }
                }
            }
        }
    }

    // "Still watching?" (sleep timer, 60 s before the end). Small and low, over any screen: the
    // timer runs whatever is on. Clicking it counts as a button.
    if root.sleep-warning : Rectangle {
        x: (parent.width - self.width) / 2;
        y: parent.height - Theme.hints-h - self.height - 48px;
        width: 520px;
        height: warning-layout.preferred-height;
        border-radius: 12px;
        border-width: 2px;
        border-color: Theme.accent-light;
        background: #18181bf0;
        TouchArea { clicked => { root.action(UiAction.select); } }
        warning-layout := VerticalLayout {
            padding: 24px;
            spacing: 8px;
            Text {
                text: "Still watching?";
                color: Theme.text;
                font-size: Theme.fs-title;
                font-weight: 800;
                horizontal-alignment: center;
            }
            Text {
                text: "Press any button to keep going. Otherwise LiveDeck stops and the device goes to sleep in a minute.";
                color: Theme.muted;
                font-size: Theme.fs-body;
                horizontal-alignment: center;
                wrap: word-wrap;
            }
        }
    }

    // Live notifications: stacked at the top right over every screen, the player included. They
    // only inform, so they take no input and never cover the hints bar.
    for toast[i] in root.toasts : Toast {
        x: parent.width - self.width - 24px;
        y: 24px + i * (Theme.toast-h + Theme.toast-gap);
        animate y { duration: Theme.t-med; easing: ease-out; }
        item: toast;
    }
    if root.toast-more > 0 : Rectangle {
        x: parent.width - self.width - 24px;
        y: 24px + root.toasts.length * (Theme.toast-h + Theme.toast-gap);
        width: more-text.preferred-width + 32px;
        height: 36px;
        border-radius: 18px;
        background: #18181bf2;
        more-text := Text {
            text: "+" + root.toast-more + " more";
            color: Theme.muted;
            font-size: Theme.fs-small;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    Rectangle {
        y: parent.height - Theme.hints-h;
        height: Theme.hints-h;
        width: parent.width;
        background: #0e0e10f0;
        // On a playing stream the bar fades out with the HUD (same rule as in player.slint) and
        // comes back on any button. Loading, paused and error screens keep it. Multiview's grid
        // hides it while idle.
        opacity: (root.screen == 1 && root.playback == 1 && !root.paused && !root.hud-visible && !root.exit-prompt && !root.player-menu-open && !root.sleep-warning && !root.raid-open && !root.compose-open && !root.popup-open && !root.strip-shown) || root.mv-idle ? 0.0 : 1.0;
        animate opacity { duration: Theme.t-med; }

        // During the sleep warning every button does the same thing.
        if root.sleep-warning : HorizontalLayout {
            padding-left: Theme.safe-x;
            padding-right: Theme.safe-x;
            alignment: end;
            Hint { glyph: "A"; label: "Any button: keep watching"; clicked => { root.action(UiAction.select); } }
        }

        // The View popup: A runs the focused row, Left/Right step the layout row, B closes it.
        if root.popup-open && !root.exit-prompt && !root.sleep-warning : HorizontalLayout {
            padding-left: Theme.safe-x;
            padding-right: Theme.safe-x;
            spacing: 36px;
            alignment: end;
            Hint { glyph: "A"; label: root.select-label; clicked => { root.action(UiAction.select); } }
            if root.popup-on-layout : Hint { glyph: "◀▶"; label: "Layout"; }
            Hint { glyph: "B"; label: "Close"; clicked => { root.action(UiAction.back); } }
        }

        // The raid card takes only A and B.
        if root.raid-open && !root.sleep-warning && !root.popup-open : HorizontalLayout {
            padding-left: Theme.safe-x;
            padding-right: Theme.safe-x;
            spacing: 36px;
            alignment: end;
            Hint { glyph: "A"; label: "Go now"; clicked => { root.action(UiAction.select); } }
            Hint { glyph: "B"; label: "Stay"; clicked => { root.action(UiAction.back); } }
        }

        // Writing in chat: the keyboard's buttons. LB and RB both turn the page (the glyph shows
        // one of them), and clicking it goes forward.
        if root.screen == 1 && root.compose-open && !root.compose-needs-sign-in && !root.sleep-warning && !root.raid-open : HorizontalLayout {
            padding-left: Theme.safe-x;
            padding-right: Theme.safe-x;
            spacing: 28px;
            alignment: end;
            Hint { glyph: "A"; label: root.select-label; clicked => { root.action(UiAction.select); } }
            Hint { glyph: "X"; label: "Delete"; clicked => { root.action(UiAction.retry); } }
            Hint { glyph: "Y"; label: "Space"; clicked => { root.action(UiAction.toggle-chat); } }
            Hint { glyph: "≡"; label: "Send"; clicked => { root.action(UiAction.menu); } }
            Hint { glyph: "RB"; label: "LB/RB Page"; clicked => { root.action(UiAction.page-right); } }
            Hint { glyph: "B"; label: "Close"; clicked => { root.action(UiAction.back); } }
        }
        if root.screen == 1 && root.compose-open && root.compose-needs-sign-in && !root.sleep-warning && !root.raid-open : HorizontalLayout {
            padding-left: Theme.safe-x;
            padding-right: Theme.safe-x;
            spacing: 36px;
            alignment: end;
            Hint { glyph: "A"; label: root.select-label; clicked => { root.action(UiAction.select); } }
            Hint { glyph: "B"; label: "Close"; clicked => { root.action(UiAction.back); } }
        }

        // Multiview's grid, and its picker.
        if root.screen == 6 && root.picker-open && !root.exit-prompt && !root.sleep-warning && !root.raid-open && !root.popup-open : HorizontalLayout {
            padding-left: Theme.safe-x;
            padding-right: Theme.safe-x;
            spacing: 36px;
            alignment: end;
            if root.select-label != "" : Hint { glyph: "A"; label: root.select-label; clicked => { root.action(UiAction.select); } }
            if root.picker-star-label != "" : Hint { glyph: "Y"; label: root.picker-star-label; clicked => { root.action(UiAction.toggle-chat); } }
            Hint { glyph: "RB"; label: "LB/RB Favorites / Following"; clicked => { root.action(UiAction.page-right); } }
            Hint { glyph: "B"; label: "Close"; clicked => { root.action(UiAction.back); } }
        }
        if root.screen == 6 && !root.picker-open && !root.exit-prompt && !root.sleep-warning && !root.raid-open && !root.popup-open : HorizontalLayout {
            padding-left: Theme.safe-x;
            padding-right: Theme.safe-x;
            spacing: 32px;
            alignment: end;
            if root.select-label != "" : Hint { glyph: "A"; label: root.select-label; clicked => { root.action(UiAction.select); } }
            if root.can-retry : Hint { glyph: "X"; label: "Retry"; clicked => { root.action(UiAction.retry); } }
            Hint { glyph: "Y"; label: root.chat-open ? "Hide chat" : "Chat"; clicked => { root.action(UiAction.toggle-chat); } }
            Hint { glyph: "RB"; label: "LB/RB Layout"; clicked => { root.action(UiAction.page-right); } }
            Hint { glyph: "View"; label: "Options"; clicked => { root.action(UiAction.view); } }
            Hint { glyph: "B"; label: "Leave"; clicked => { root.action(UiAction.back); } }
        }

        // Empty while the quit prompt is open: the prompt shows its own buttons.
        if !root.exit-prompt && !root.sleep-warning && !root.raid-open && !root.popup-open && root.screen != 6 && !(root.screen == 1 && root.compose-open) : HorizontalLayout {
            padding-left: Theme.safe-x;
            padding-right: Theme.safe-x;
            spacing: 36px;
            alignment: end;

            if root.screen == 0 || root.screen == 3 : Hint { glyph: "A"; label: root.rail-focused ? "Open" : root.select-label; clicked => { root.action(UiAction.select); } }
            if (root.screen == 0 || root.screen == 3) && root.can-retry : Hint { glyph: "X"; label: "Retry"; clicked => { root.action(UiAction.retry); } }
            // A live stream card: pick it for multiview, or watch the picked ones (and star it). An
            // offline channel card: star it.
            if (root.screen == 0 || root.screen == 3) && root.can-view : Hint { glyph: "View"; label: root.view-label; clicked => { root.action(UiAction.view); } }
            if root.screen == 0 || root.screen == 3 : Hint { glyph: "≡"; label: "Menu"; clicked => { root.action(UiAction.menu); } }
            if root.screen == 1 && root.select-label != "" : Hint { glyph: "A"; label: root.select-label; clicked => { root.action(UiAction.select); } }
            if root.screen == 1 && root.can-retry : Hint { glyph: "X"; label: "Retry"; clicked => { root.action(UiAction.retry); } }
            // The subscribe card takes only A and B: "A Open in browser · B Close", or only B in
            // Game Mode (`select-label` is empty there).
            if root.screen == 1 && !root.subscribe-open : Hint { glyph: "Y"; label: root.chat-open ? "Hide chat" : "Show chat"; clicked => { root.action(UiAction.toggle-chat); } }
            // Start opens the player menu. With it open, B closes it instead of leaving the stream.
            if root.screen == 1 && !root.player-menu-open : Hint { glyph: "≡"; label: "Options"; clicked => { root.action(UiAction.menu); } }
            if root.screen == 1 && root.player-menu-open : Hint { glyph: "B"; label: "Close"; clicked => { root.action(UiAction.back); } }
            // Multiview's full screen: LB/RB flip through the streams, View has its options.
            if root.screen == 1 && root.mv-active && root.mv-count > 1 && !root.player-menu-open && !root.subscribe-open : Hint { glyph: "RB"; label: "LB/RB Next stream"; clicked => { root.action(UiAction.page-right); } }
            if root.screen == 1 && !root.player-menu-open && !root.subscribe-open : Hint { glyph: "View"; label: "Multiview"; clicked => { root.action(UiAction.view); } }
            if (root.screen == 1 && !root.player-menu-open) || root.screen == 2 || (root.screen == 3 && root.can-back) : Hint { glyph: "B"; label: root.screen == 1 && root.mv-active ? "Grid" : "Back"; clicked => { root.action(UiAction.back); } }
            // Root screens: nowhere further back, so B opens the sidebar, and B on the sidebar asks to quit.
            if (root.screen == 0 || (root.screen == 3 && !root.can-back) || root.screen == 4) && !root.rail-focused : Hint { glyph: "B"; label: "Sidebar"; clicked => { root.action(UiAction.back); } }
            if (root.screen == 0 || (root.screen == 3 && !root.can-back) || root.screen == 4) && root.rail-focused : Hint { glyph: "B"; label: "Quit"; clicked => { root.action(UiAction.back); } }
            if root.screen == 2 && root.login-failed : Hint { glyph: "A"; label: "New code"; clicked => { root.action(UiAction.select); } }
            if root.screen == 4 : Hint { glyph: "A"; label: root.rail-focused ? "Open" : root.select-label; clicked => { root.action(UiAction.select); } }
            if root.screen == 4 : Hint { glyph: "≡"; label: "Menu"; clicked => { root.action(UiAction.menu); } }
            // Search, on the keyboard: X deletes, Y types a space, Start goes to the results, and
            // B deletes too until the text is empty, then asks to quit.
            if root.screen == 5 && root.search-on-keys : Hint { glyph: "A"; label: root.select-label; clicked => { root.action(UiAction.select); } }
            if root.screen == 5 && root.search-on-keys : Hint { glyph: "X"; label: "Delete"; clicked => { root.action(UiAction.retry); } }
            if root.screen == 5 && root.search-on-keys : Hint { glyph: "Y"; label: "Space"; clicked => { root.action(UiAction.toggle-chat); } }
            if root.screen == 5 && root.search-on-keys : Hint { glyph: "≡"; label: "Results"; clicked => { root.action(UiAction.menu); } }
            if root.screen == 5 && root.search-on-keys && root.search-query == "" && !root.rail-focused : Hint { glyph: "B"; label: "Sidebar"; clicked => { root.action(UiAction.back); } }
            if root.screen == 5 && root.search-on-keys && root.search-query == "" && root.rail-focused : Hint { glyph: "B"; label: "Quit"; clicked => { root.action(UiAction.back); } }
            // Search, in the results (or the rail): like Home, and B returns to the keyboard.
            if root.screen == 5 && !root.search-on-keys : Hint { glyph: "A"; label: root.rail-focused ? "Open" : root.select-label; clicked => { root.action(UiAction.select); } }
            if root.screen == 5 && root.search-in-results && root.can-retry && !root.rail-focused : Hint { glyph: "X"; label: "Retry"; clicked => { root.action(UiAction.retry); } }
            if root.screen == 5 && root.can-view : Hint { glyph: "View"; label: root.view-label; clicked => { root.action(UiAction.view); } }
            if root.screen == 5 && !root.search-on-keys : Hint { glyph: "≡"; label: "Menu"; clicked => { root.action(UiAction.menu); } }
            if root.screen == 5 && root.search-in-results && !root.rail-focused : Hint { glyph: "B"; label: "Keyboard"; clicked => { root.action(UiAction.back); } }
        }
    }
}
