import { Theme } from "theme.slint";
import { StreamItem, ChatMsg, SearchKey } from "types.slint";
import { ChatLine } from "components.slint";

// The bottom of the chat: the room's rules, why the last message did not go, the message being
// written (with a caret and a counter) and, while not writing, how to start.
component ComposeLine inherits VerticalLayout {
    in property <bool> open;
    in property <string> text;
    in property <string> count;
    in property <string> status;
    in property <bool> problem;
    in property <string> room-mode;
    in property <string> hint;
    property <bool> caret-on: true;

    spacing: 6px;

    Timer {
        interval: 530ms;
        running: root.open;
        triggered => { root.caret-on = !root.caret-on; }
    }

    if root.room-mode != "" : Text {
        text: root.room-mode;
        color: Theme.muted;
        font-size: Theme.fs-small;
        wrap: word-wrap;
    }
    if root.status != "" : Text {
        text: root.status;
        color: root.problem ? Theme.btn-b : Theme.muted;
        font-size: Theme.fs-small;
        font-weight: root.problem ? 700 : 400;
        wrap: word-wrap;
    }
    // While closed, a draft stays visible (dimmed) until it is sent or the channel changes.
    if root.open || root.text != "" : Rectangle {
        border-radius: 8px;
        background: Theme.surface-high;
        border-width: 2px;
        border-color: root.open ? Theme.accent-light : transparent;
        opacity: root.open ? 1.0 : 0.6;
        height: box.preferred-height;
        box := VerticalLayout {
            padding: 10px;
            spacing: 2px;
            Text {
                text: root.text == "" ? "Write in chat" : root.text + (root.open && root.caret-on ? "|" : " ");
                color: root.text == "" ? Theme.muted : Theme.text;
                font-size: Theme.fs-chat;
                wrap: word-wrap;
            }
            if root.open : Text {
                text: root.count;
                color: Theme.muted;
                font-size: 13px;
                horizontal-alignment: right;
            }
        }
    }
    if root.hint != "" : Text {
        text: root.hint;
        color: Theme.muted;
        font-size: Theme.fs-small;
        wrap: word-wrap;
    }
}

// The chat keyboard with the quick messages above it. Which key or message has focus is decided in
// Rust (htpc_core::reduce); this only draws it. With a token that may not chat it shows what to do
// instead.
component ComposeKeys inherits Rectangle {
    in property <[SearchKey]> keys;
    in property <int> key-focus;
    // 0 off, 1 the next letter, 2 locked.
    in property <int> shift;
    in property <[string]> chips;
    in property <int> chip-focus;
    in property <bool> needs-sign-in;
    property <length> key-w: Theme.compose-key-w;
    property <length> key-h: Theme.compose-key-h;
    property <length> gap: Theme.compose-key-gap;
    property <length> keys-top: 16px + Theme.compose-chip-h + 12px;

    width: 10 * root.key-w + 9 * root.gap;
    height: Theme.compose-h;
    clip: true;

    if root.needs-sign-in : VerticalLayout {
        alignment: center;
        spacing: 12px;
        Text {
            text: "Chat needs a new Twitch sign-in";
            color: Theme.text;
            font-size: Theme.fs-title;
            font-weight: 800;
            horizontal-alignment: center;
        }
        Text {
            text: "Your sign-in is from before LiveDeck could write in chat. Sign in again to allow it: it takes a minute, and you come back to this stream.";
            color: Theme.muted;
            font-size: Theme.fs-body;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Text {
            text: "A: Sign in again";
            color: Theme.accent-light;
            font-size: Theme.fs-body;
            font-weight: 700;
            horizontal-alignment: center;
        }
    }

    if !root.needs-sign-in : HorizontalLayout {
        y: 16px;
        height: Theme.compose-chip-h;
        spacing: 8px;
        alignment: start;
        for chip[i] in root.chips : Rectangle {
            width: chip-text.preferred-width + 28px;
            border-radius: self.height / 2;
            background: i == root.chip-focus ? Theme.accent : Theme.surface-high;
            animate background { duration: Theme.t-fast; }
            chip-text := Text {
                text: chip;
                color: i == root.chip-focus ? Theme.text : Theme.muted;
                font-size: Theme.fs-small;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }
    }

    if !root.needs-sign-in : Rectangle {
        y: root.keys-top;
        height: 5 * root.key-h + 4 * root.gap;
        for key[i] in root.keys : Rectangle {
            property <bool> focused: i == root.key-focus;
            property <bool> lit: key.label == "shift" && root.shift > 0;
            x: key.col * (root.key-w + root.gap);
            y: key.row * (root.key-h + root.gap);
            width: key.span * root.key-w + (key.span - 1) * root.gap;
            height: root.key-h;
            border-radius: 6px;
            background: self.focused ? Theme.accent : Theme.surface;
            border-width: self.lit ? 2px : 0px;
            // Locked shift is drawn brighter than a one-letter shift.
            border-color: root.shift == 2 ? Theme.text : Theme.accent-light;
            animate background { duration: Theme.t-fast; }

            Text {
                text: key.label;
                color: parent.focused || parent.lit ? Theme.text : Theme.muted;
                // Emote codes and the page keys are words: smaller, so they fit two columns.
                font-size: key.span > 1 ? Theme.fs-small : Theme.fs-body;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

// The raid card: "<from> is raiding <to>", "with 1,234 viewers", and a bar that empties over the
// 10 s countdown (RAID_SECONDS in htpc-core) in one animation, started when the card is created.
// The hints bar has its buttons (A Go now · B Stay). Over the player and multiview's grid.
export component RaidCard inherits Rectangle {
    in property <string> title;
    in property <string> viewers;
    in property <int> seconds;

    height: raid-layout.preferred-height;
    border-radius: 12px;
    border-width: 2px;
    border-color: Theme.accent-light;
    background: #18181bf0;
    TouchArea { }

    raid-layout := VerticalLayout {
        padding: 24px;
        spacing: 8px;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: Theme.fs-title;
            font-weight: 800;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        if root.viewers != "" : Text {
            text: root.viewers;
            color: Theme.muted;
            font-size: Theme.fs-body;
            horizontal-alignment: center;
        }
        Text {
            text: "Going there in " + root.seconds + "…";
            color: Theme.accent-light;
            font-size: Theme.fs-body;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Rectangle {
            height: 6px;
            border-radius: 3px;
            background: #ffffff1f;
            bar := Rectangle {
                property <bool> started: false;
                x: 0px;
                height: parent.height;
                width: self.started ? 0px : parent.width;
                border-radius: 3px;
                background: Theme.accent;
                animate width { duration: 10s; easing: linear; }
            }
            // A change made while the card is created (`init`) lands before the first frame and
            // would not animate, so the bar starts on the next tick.
            Timer {
                interval: 1ms;
                running: !bar.started;
                triggered => { bar.started = true; }
            }
        }
    }
}

// The chat lines, newest at the bottom. Older ones are pushed up and clipped at the top.
export component ChatList inherits Rectangle {
    in property <[ChatMsg]> chat;
    clip: true;
    // The block is as tall as its lines and sits on the bottom edge. A layout with `alignment: end`
    // would let a full list spill past the bottom instead, hiding the newest lines.
    block := VerticalLayout {
        x: 0px;
        width: root.width;
        height: self.preferred-height;
        y: root.height - self.height;
        spacing: 8px;
        for m in root.chat : ChatLine {
            msg: m;
            line-w: root.width;
        }
    }
}

// One row of the player menu: what it changes on the left, its value between arrows on the right.
component MenuRow inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <bool> focused;
    // Cannot be changed right now (Quality while audio only is on): no arrows, dimmed value.
    in property <bool> locked: false;
    // An action row (Subscribe): no value and no arrows, A runs it.
    in property <bool> action: false;

    height: Theme.menu-row-h;
    border-radius: 6px;
    background: root.focused ? Theme.surface-high : transparent;
    border-width: 2px;
    border-color: root.focused ? Theme.accent-light : transparent;
    animate border-color, background { duration: Theme.t-fast; }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: Theme.fs-body;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            // An action row with a value says why A does nothing (signed out).
            text: root.action ? (root.value != "" ? root.value : (root.focused ? "Press A" : "")) : root.focused && !root.locked ? "◀  " + root.value + "  ▶" : root.value;
            color: root.focused && !root.locked ? Theme.accent-light : Theme.muted;
            opacity: root.locked ? 0.6 : 1.0;
            font-size: Theme.fs-body;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
}

// What audio only shows instead of the video: a small, dim block of the channel, its title and
// thumbnail on black, which glides to a new spot every 30 s. Like a screensaver, no pixel stays lit
// long enough to burn in, and nothing is redrawn between glides (a constant animation would redraw
// at full frame rate, costing more battery than skipping the video saves). Black pixels are off
// on an OLED Deck.
component AudioWatermark inherits Rectangle {
    in property <StreamItem> stream;
    // The part of the parent the block may use: chat covers the rest.
    in property <length> area-w;
    in property <length> area-h;
    // Show the darkened thumbnail next to the text, when there is one.
    in property <bool> show-thumbnail: true;

    // Moves so far. Each spot comes from an R2 sequence: spread out like random ones, but with no
    // randomness, and never close to the previous spot.
    property <int> step: 0;
    property <float> fx: mod(0.5 + root.step * 0.7548777, 1.0);
    property <float> fy: mod(0.5 + root.step * 0.5698403, 1.0);
    property <length> margin: 32px;

    glide := Timer {
        interval: 30s;
        running: true;
        triggered => { root.step += 1; }
    }

    block := Rectangle {
        width: block-layout.preferred-width;
        height: block-layout.preferred-height;
        x: root.margin + root.fx * max(0px, root.area-w - 2 * root.margin - self.width);
        y: root.margin + root.fy * max(0px, root.area-h - Theme.hints-h - 2 * root.margin - self.height);
        animate x, y { duration: 3s; easing: ease-in-out; }

        block-layout := HorizontalLayout {
            spacing: 20px;
            if root.show-thumbnail && root.stream.thumb-url != "" : Rectangle {
                width: 160px;
                height: 90px;
                border-radius: 8px;
                clip: true;
                opacity: 0.28;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.stream.thumbnail;
                    image-fit: cover;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 6px;
                // The stream's tint, the only colour on screen.
                Rectangle {
                    width: 48px;
                    height: 3px;
                    border-radius: 1.5px;
                    background: root.stream.tint;
                    opacity: 0.7;
                }
                Text {
                    text: root.stream.channel;
                    color: #ffffff40;
                    font-size: Theme.fs-display;
                    font-weight: 800;
                }
                Text {
                    text: root.stream.title;
                    color: #ffffff26;
                    font-size: Theme.fs-body;
                    overflow: elide;
                    max-width: 520px;
                }
                Text {
                    text: "♪  Audio only";
                    color: #ffffff26;
                    font-size: Theme.fs-small;
                    letter-spacing: 2px;
                }
            }
        }
    }
}

// The hype train bar: level, points toward the next level, and the time left. The app checks every
// 10 s; in between, the time left counts down here with a 1 s Timer (not `animation-tick()`, which
// would redraw at full frame rate). Each check sets it again. A level up glows once.
// Compact: a round badge instead (a train over the level), its border a ring that fills up as the
// level does. The player shows it while its HUD is hidden, so the bar does not sit over the video.
component HypeBar inherits Rectangle {
    in property <int> level;
    in property <int> permille;
    in property <string> points;
    in property <int> seconds;
    in property <bool> compact: false;
    property <int> left: root.seconds;
    property <bool> glow: false;
    // The ring's fill, eased like the bar's. Short of 1000 so a full ring still has two ends.
    property <float> ring: min(root.permille, 999) / 1000;
    animate ring { duration: Theme.t-med; easing: ease-out; }
    property <angle> ring-end: root.ring * 360deg;

    changed seconds => { root.left = root.seconds; }
    changed level => { root.glow = true; }

    Timer {
        interval: 1s;
        running: root.left > 0;
        triggered => { root.left -= 1; }
    }
    Timer {
        interval: 900ms;
        running: root.glow;
        triggered => { root.glow = false; }
    }

    height: root.compact ? Theme.hype-badge : bar-layout.preferred-height;
    border-radius: root.compact ? self.height / 2 : 10px;
    // The compact badge's ring is its border.
    border-width: root.compact ? 0px : 2px;
    border-color: root.glow ? Theme.accent-light : Theme.surface-high;
    background: root.glow ? #2a1f3df0 : #18181be0;
    animate border-color, background { duration: Theme.t-med; }

    if root.compact : Rectangle {
        width: parent.width;
        height: parent.height;
        // The ring's track.
        Rectangle {
            border-radius: self.height / 2;
            border-width: 4px;
            border-color: root.glow ? Theme.accent-light : #ffffff1f;
            animate border-color { duration: Theme.t-med; }
        }
        // How far the level has come, clockwise from the top. The viewbox matches the badge, so
        // the arc's radius (30) runs down the middle of the 4px track.
        if root.ring > 0 : Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 64;
            viewbox-height: 64;
            commands: "M 32 2 A 30 30 0 " + (root.ring > 0.5 ? "1" : "0") + " 1 " + (32 + 30 * Math.sin(root.ring-end)) + " " + (32 - 30 * Math.cos(root.ring-end));
            stroke: Theme.accent-light;
            stroke-width: 4px;
        }
        VerticalLayout {
            alignment: center;
            spacing: 0px;
            HorizontalLayout {
                alignment: center;
                // A locomotive seen from the front: body, windscreen, lamps and rails.
                Path {
                    width: 20px;
                    height: 20px;
                    viewbox-width: 24;
                    viewbox-height: 24;
                    commands: "M7 3h10a3 3 0 0 1 3 3v8a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V6a3 3 0 0 1 3-3z M4 10h16 M7 13.5h2 M15 13.5h2 M8 17l-2 4 M16 17l2 4";
                    stroke: Theme.accent-light;
                    stroke-width: 2px;
                }
            }
            Text {
                text: root.level;
                color: Theme.text;
                font-size: Theme.fs-body;
                font-weight: 800;
                horizontal-alignment: center;
            }
        }
    }

    bar-layout := VerticalLayout {
        visible: !root.compact;
        padding: 12px;
        padding-top: 10px;
        spacing: 8px;
        HorizontalLayout {
            spacing: 12px;
            Text {
                text: "HYPE TRAIN";
                color: Theme.accent-light;
                font-size: Theme.fs-small;
                font-weight: 800;
                letter-spacing: 3px;
                vertical-alignment: center;
            }
            Text {
                text: "Level " + root.level;
                color: Theme.text;
                font-size: Theme.fs-body;
                font-weight: 800;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: floor(root.left / 60) + ":" + (mod(root.left, 60) < 10 ? "0" : "") + mod(root.left, 60);
                color: Theme.muted;
                font-size: Theme.fs-small;
                vertical-alignment: center;
            }
        }
        Rectangle {
            height: 6px;
            border-radius: 3px;
            background: #ffffff1f;
            Rectangle {
                x: 0px;
                height: parent.height;
                width: parent.width * root.permille / 1000;
                border-radius: 3px;
                background: Theme.accent;
                animate width { duration: Theme.t-med; easing: ease-out; }
            }
        }
        Text {
            text: root.points;
            color: Theme.muted;
            font-size: Theme.fs-small;
            horizontal-alignment: right;
        }
    }
}

// Chat is a side panel (the video shrinks to make room) or an overlay (lines over the video).
export component PlayerScreen inherits Rectangle {
    in property <StreamItem> stream;
    in property <[ChatMsg]> chat;
    in property <bool> chat-open;
    // Overlay layout instead of the side panel (the `chat_layout` setting).
    in property <bool> chat-overlay: false;
    // Connection state to show next to the chat ("Connecting…"), empty when all is well.
    in property <string> chat-status: "";
    // The latest video frame (a GL texture rendered by mpv).
    in property <image> video;
    // 0 loading, 1 playing, 2 offline, 3 failed (PlaybackId in view_model.rs).
    in property <int> playback: 0;
    in property <string> playback-error: "";
    // The player's last log lines before the failure, one per line.
    in property <string> playback-details: "";
    in property <bool> paused: false;
    in property <bool> hud-visible: true;
    // The player menu (Start): open, its focused row and the value of each row (PlayerMenuRow
    // order in htpc-core: quality, hardware decoding, latency, zoom, stats, audio only, sleep).
    in property <bool> menu-open: false;
    in property <int> menu-focus: 0;
    in property <[string]> menu-values: [];
    // Sound only: a black screen with a drifting watermark instead of the video.
    in property <bool> audio-only: false;
    // The stats box, one fact per line. Empty hides it.
    in property <string> stats-text: "";
    // The sleep timer next to the channel name ("Sleep in 42 min"). Empty without one.
    in property <string> sleep-label: "";
    // The subscribe card (player menu): open, the page's QR code (one pixel per module, with its
    // quiet zone), its address to type, and whether A opens it in a browser (not in Game Mode).
    in property <bool> subscribe-open: false;
    in property <image> subscribe-qr;
    in property <string> subscribe-url: "";
    in property <bool> subscribe-can-open: false;
    // The raid card: "<from> is raiding <to>", "with 1,234 viewers", and the seconds left before
    // following. The hints bar has its buttons (A Go now · B Stay).
    in property <bool> raid-open: false;
    in property <string> raid-title: "";
    in property <string> raid-viewers: "";
    in property <int> raid-seconds: 0;
    // The hype train bar (view_model.rs `hype_*`), while a train runs in this channel.
    in property <bool> hype-open: false;
    in property <int> hype-level: 0;
    in property <int> hype-permille: 0;
    in property <string> hype-points: "";
    in property <int> hype-seconds: 0;
    // A train started or levelled up a moment ago: the full bar shows even while the HUD is hidden.
    property <bool> hype-peek: false;
    changed hype-level => {
        root.hype-peek = root.hype-level > 0;
        hype-peek-timer.restart();
    }
    hype-peek-timer := Timer {
        interval: 5s;
        running: root.hype-peek;
        triggered => { root.hype-peek = false; }
    }
    // Writing in chat (view_model.rs `compose_*`): the panel, its keys and quick messages, the
    // message so far, its state, the room's rules, and the line shown under the chat otherwise.
    in property <bool> compose-open: false;
    in property <bool> compose-needs-sign-in: false;
    in property <string> compose-text: "";
    in property <string> compose-count: "";
    in property <[SearchKey]> compose-keys;
    in property <int> compose-key-focus: 0;
    in property <int> compose-shift: 0;
    in property <[string]> compose-chips;
    in property <int> compose-chip-focus: -1;
    in property <string> compose-status: "";
    in property <bool> compose-problem: false;
    in property <string> room-mode: "";
    in property <string> compose-hint: "";
    // The index of the first action row (PlayerMenuRow::Subscribe). The ones after it (Write in
    // chat) are action rows too.
    property <int> subscribe-row: 7;
    // The side layout gives the keyboard the bottom of the video's strip.
    property <length> compose-cut: root.compose-open && !root.chat-overlay ? Theme.compose-h + Theme.hints-h : 0px;
    property <[string]> menu-titles: ["Quality", "Hardware decoding", "Latency", "Zoom", "Stats", "Audio only", "Sleep timer", "Subscribe to " + root.stream.channel, "Write in chat"];
    // What each row does, shown under the rows for the focused one. Same order as the titles.
    property <[string]> menu-help: [
        "Picture quality. Lower uses less data and battery. Reloads the stream.",
        "Decode on the graphics chip. Turn off if the picture stutters or shows glitches.",
        "Low stays close to live. Normal buffers more, for fewer stalls on weak Wi-Fi. Reloads the stream.",
        "Fit shows the whole picture with black bars. Fill crops it to fill the screen.",
        "A box with resolution, codec, bitrate, buffer and dropped frames.",
        "Sound only, on a dark screen. Saves data and battery. For this stream only.",
        "Stops the stream and puts the device to sleep after a while. Asks a minute before.",
        "Shows a QR code of the channel's subscribe page, to finish on your phone.",
        "Write in this channel's chat with the on-screen keyboard or quick messages. X does it too while chat is shown.",
    ];

    // Skeleton pulse, 0..1 (only ticks while a skeleton is shown).
    property <float> pulse: 0.5 + 0.5 * Math.sin(mod(animation-tick() / Theme.t-pulse, 1) * 360deg);

    Rectangle {
        // Slint centres a child that is smaller than its parent unless x and y are set, which
        // would push the video to the right while the side panel is open.
        x: 0px;
        y: 0px;
        width: parent.width - (root.chat-open && !root.chat-overlay ? Theme.chat-w : 0px);
        height: parent.height - root.compose-cut;
        animate width, height { duration: Theme.t-med; easing: ease-out; }
        background: #000000;
        clip: true;

        Image {
            width: parent.width;
            height: parent.height;
            source: root.video;
            image-fit: fill;
            // mpv sends no frames in audio only, but the texture may still hold the last one.
            visible: root.playback == 1 && !root.audio-only;
        }

        // Audio only: pure black, and the watermark keeps clear of an open chat overlay (the side
        // panel already narrows this rectangle).
        if root.playback == 1 && root.audio-only : AudioWatermark {
            width: parent.width;
            height: parent.height;
            stream: root.stream;
            area-w: parent.width - (root.chat-open && root.chat-overlay ? Theme.chat-overlay-w : 0px);
            area-h: parent.height;
        }

        // Loading: the stream's tint, pulsing, until the first frame. Created only while loading,
        // so the pulse's animation clock does not keep the window redrawing afterwards.
        if root.playback == 0 : Rectangle {
            background: @linear-gradient(135deg, root.stream.tint, #000000);
            opacity: 0.55 + 0.45 * root.pulse;
        }
        Text {
            visible: root.playback == 0;
            text: root.audio-only ? "Starting audio…" : "Starting stream…";
            color: Theme.text;
            font-size: Theme.fs-body;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        // End screen: the channel is not live (any more), or the stream could not start.
        Rectangle {
            visible: root.playback == 2 || root.playback == 3;
            background: @linear-gradient(135deg, root.stream.tint, #000000);
            VerticalLayout {
                alignment: center;
                spacing: 12px;
                padding: 48px;
                Text {
                    text: root.playback == 2 ? root.stream.channel + " is offline" : "Could not start the stream";
                    color: Theme.text;
                    font-size: Theme.fs-display;
                    font-weight: 800;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                // The app looks for the stream again every 10 s (OFFLINE_RECHECK in the app's
                // playback.rs) and plays it as soon as it is back, e.g. after a 24 h restart.
                Text {
                    visible: root.playback == 2;
                    text: "Checking every 10 seconds, it will play as soon as it is back";
                    color: Theme.muted;
                    font-size: Theme.fs-body;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    visible: root.playback == 3;
                    text: root.playback-error;
                    color: Theme.muted;
                    font-size: Theme.fs-body;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                // What mpv (or Streamlink) said, left-aligned on a dark panel so a photo of the
                // screen can be read.
                if root.playback == 3 && root.playback-details != "" : Rectangle {
                    background: #000000a0;
                    border-radius: 8px;
                    VerticalLayout {
                        padding: 16px;
                        Text {
                            text: root.playback-details;
                            color: Theme.text;
                            font-size: Theme.fs-small;
                            wrap: word-wrap;
                        }
                    }
                }
                Text {
                    text: "Press A or X to try again  ·  B to go back";
                    color: Theme.accent-light;
                    font-size: Theme.fs-body;
                    horizontal-alignment: center;
                }
            }
        }

        // Paused badge.
        Rectangle {
            visible: root.playback == 1 && root.paused;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 120px;
            height: 120px;
            border-radius: 60px;
            background: #000000a0;
            Text {
                text: "❚❚";
                color: Theme.text;
                font-size: 44px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Stats box ("nerds view"): top left, over the video, on every stream until turned off.
        // While the menu is open it moves to the menu's right, as the menu is tall enough to
        // cover it, and narrows if the chat panel leaves less room.
        if root.stats-text != "" : Rectangle {
            x: Theme.safe-x / 2 + (root.menu-open ? Theme.menu-w + 16px : 0px);
            y: 24px;
            width: min(Theme.stats-w, parent.width - self.x - 16px);
            height: stats-layout.preferred-height;
            background: #000000b8;
            border-radius: 8px;
            stats-layout := VerticalLayout {
                padding: 14px;
                Text {
                    text: root.stats-text;
                    color: Theme.text;
                    font-size: Theme.fs-small;
                    wrap: word-wrap;
                }
            }
        }

        // Hype train: top centre, but right of the stats box when it is on and left of an open
        // chat overlay. It stays up while the train runs. Once the HUD hides it shrinks to a badge
        // in the top right corner, and any button that brings the HUD back opens it again, as does
        // a new level (for a few seconds).
        if root.hype-open && root.playback == 1 : HypeBar {
            property <length> left-edge: root.stats-text != "" ? Theme.safe-x / 2 + (root.menu-open ? Theme.menu-w + 16px : 0px) + Theme.stats-w + 16px : 16px;
            property <length> right-edge: parent.width - (root.chat-open && root.chat-overlay ? Theme.chat-overlay-w : 0px) - 16px;
            compact: !(root.hud-visible || root.menu-open || root.paused || root.hype-peek);
            width: self.compact ? Theme.hype-badge : max(0px, min(420px, self.right-edge - self.left-edge));
            x: self.compact ? self.right-edge - self.width : max(self.left-edge, (16px + self.right-edge - self.width) / 2);
            y: 24px;
            level: root.hype-level;
            permille: root.hype-permille;
            points: root.hype-points;
            seconds: root.hype-seconds;
        }

        // Player menu: bottom left, just above the HUD text. Up/Down pick a row, Left/Right change
        // it (see `player_menu_intent` in htpc-core).
        if root.menu-open : Rectangle {
            x: Theme.safe-x / 2;
            y: parent.height - 190px - self.height - 8px;
            width: Theme.menu-w;
            height: menu-layout.preferred-height;
            background: #18181bf0;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.surface-high;
            menu-layout := VerticalLayout {
                padding: 12px;
                spacing: 4px;
                Text {
                    text: "OPTIONS";
                    color: Theme.accent-light;
                    font-size: Theme.fs-small;
                    font-weight: 800;
                    letter-spacing: 3px;
                }
                for title[i] in root.menu-titles : MenuRow {
                    title: title;
                    value: root.menu-values[i];
                    focused: root.menu-focus == i;
                    locked: i == 0 && root.audio-only;
                    action: i >= root.subscribe-row;
                }
                Text {
                    text: root.menu-focus == 0 && root.audio-only ? "Locked while Audio only is on." : root.menu-help[root.menu-focus];
                    color: Theme.text;
                    font-size: Theme.fs-small;
                    wrap: word-wrap;
                }
                Text {
                    text: "Not saved: lasts until LiveDeck quits";
                    color: Theme.muted;
                    font-size: Theme.fs-small;
                }
            }
        }

        // HUD: channel, title and viewers. Fades out on its own while playing, never while the
        // menu is open. The keyboard takes its place while writing in chat.
        Rectangle {
            y: parent.height - 190px;
            height: 190px;
            opacity: root.compose-open ? 0.0 : (root.hud-visible || root.menu-open || root.playback != 1 || root.paused) ? 1.0 : 0.0;
            animate opacity { duration: Theme.t-med; }
            background: @linear-gradient(180deg, #00000000, #000000d0);

            VerticalLayout {
                padding-left: Theme.safe-x;
                padding-right: Theme.safe-x;
                padding-bottom: Theme.hints-h + 8px;
                alignment: end;
                spacing: 4px;

                HorizontalLayout {
                    alignment: start;
                    spacing: 16px;
                    Text {
                        text: root.stream.channel;
                        color: Theme.text;
                        font-size: Theme.fs-title;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                    // Fades with the rest of the HUD, and any button shows it again.
                    if root.sleep-label != "" : Rectangle {
                        width: sleep-text.preferred-width + 20px;
                        height: sleep-text.preferred-height + 8px;
                        y: (parent.height - self.height) / 2;
                        border-radius: self.height / 2;
                        background: #ffffff1f;
                        sleep-text := Text {
                            text: root.sleep-label;
                            color: Theme.text;
                            font-size: Theme.fs-small;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }
                Text {
                    text: root.stream.title + "  ·  " + root.stream.viewers;
                    color: Theme.muted;
                    font-size: Theme.fs-small;
                    overflow: elide;
                }
            }
        }

        // Raid card: bottom centre, just above the HUD text, over the stream that plays on (or the
        // offline screen). The bar empties over the 10 s countdown (RAID_SECONDS in htpc-core) in
        // one animation, started when the card is created.
        if root.raid-open : RaidCard {
            x: (parent.width - self.width) / 2;
            y: parent.height - 190px - self.height;
            width: min(560px, parent.width - 32px);
            title: root.raid-title;
            viewers: root.raid-viewers;
            seconds: root.raid-seconds;
        }

        // Subscribe card: over the video (and the menu) on a dark scrim, while the stream plays
        // on. Chat is left as it is. The QR code is drawn like the sign-in screen's. The scrim
        // swallows clicks; the hints bar has the buttons.
        if root.subscribe-open : Rectangle {
            background: #000000b8;
            TouchArea { }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - Theme.hints-h - self.height) / 2;
                width: 440px;
                height: card-layout.preferred-height;
                border-radius: 12px;
                border-width: 2px;
                border-color: Theme.surface-high;
                background: Theme.surface;

                card-layout := VerticalLayout {
                    padding: 32px;
                    spacing: 14px;
                    alignment: center;
                    Text {
                        text: "Subscribe to " + root.stream.channel;
                        color: Theme.text;
                        font-size: Theme.fs-title;
                        font-weight: 800;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: "Scan to subscribe on your phone";
                        color: Theme.muted;
                        font-size: Theme.fs-body;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 240px;
                            height: 240px;
                            background: #ffffff;
                            border-radius: 8px;
                            clip: true;
                            Image {
                                width: parent.width;
                                height: parent.height;
                                source: root.subscribe-qr;
                                image-fit: contain;
                                image-rendering: pixelated;
                            }
                        }
                    }
                    Text {
                        text: root.subscribe-url;
                        color: Theme.accent-light;
                        font-size: Theme.fs-body;
                        font-weight: 700;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }

    // The chat keyboard. Side layout: in the strip under the shrunk video. Overlay: over the
    // bottom of the video, left of the chat. Either way above the hints bar.
    if root.compose-open : Rectangle {
        property <length> area-w: parent.width - (root.chat-overlay ? Theme.chat-overlay-w : Theme.chat-w);
        x: 0px;
        y: parent.height - Theme.hints-h - Theme.compose-h;
        width: self.area-w;
        height: Theme.compose-h;
        background: root.chat-overlay ? #000000c8 : Theme.bg;

        ComposeKeys {
            x: (parent.width - self.width) / 2;
            y: 0px;
            keys: root.compose-keys;
            key-focus: root.compose-key-focus;
            shift: root.compose-shift;
            chips: root.compose-chips;
            chip-focus: root.compose-chip-focus;
            needs-sign-in: root.compose-needs-sign-in;
        }
    }

    // Side panel: slides in from the right, over the strip the video made room for.
    if !root.chat-overlay : Rectangle {
        x: parent.width - (root.chat-open ? Theme.chat-w : 0px);
        width: Theme.chat-w;
        height: parent.height;
        background: Theme.surface;
        clip: true;
        animate x { duration: Theme.t-med; easing: ease-out; }

        VerticalLayout {
            padding: Theme.chat-pad;
            padding-bottom: Theme.hints-h + 8px;
            spacing: 12px;

            HorizontalLayout {
                Text {
                    text: "CHAT";
                    color: Theme.accent-light;
                    font-size: Theme.fs-small;
                    font-weight: 800;
                    letter-spacing: 3px;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.chat-status;
                    color: Theme.muted;
                    font-size: Theme.fs-small;
                }
            }
            ChatList {
                chat: root.chat;
                vertical-stretch: 1;
            }
            ComposeLine {
                open: root.compose-open && !root.compose-needs-sign-in;
                text: root.compose-text;
                count: root.compose-count;
                status: root.compose-status;
                problem: root.compose-problem;
                room-mode: root.room-mode;
                hint: root.compose-hint;
            }
        }
    }

    // Overlay: lines over the right of the video on a soft scrim, above the hints bar. It fades
    // in and out, and the video keeps its full size.
    if root.chat-overlay : Rectangle {
        x: parent.width - Theme.chat-overlay-w;
        width: Theme.chat-overlay-w;
        height: parent.height;
        opacity: root.chat-open ? 1.0 : 0.0;
        animate opacity { duration: Theme.t-med; }
        background: @linear-gradient(90deg, #00000000, #000000b0);

        VerticalLayout {
            padding: Theme.chat-pad;
            padding-bottom: Theme.hints-h + 8px;
            spacing: 8px;

            Text {
                text: root.chat-status;
                color: Theme.muted;
                font-size: Theme.fs-small;
                horizontal-alignment: right;
            }
            ChatList {
                chat: root.chat;
                vertical-stretch: 1;
            }
            ComposeLine {
                open: root.compose-open && !root.compose-needs-sign-in;
                text: root.compose-text;
                count: root.compose-count;
                status: root.compose-status;
                problem: root.compose-problem;
                room-mode: root.room-mode;
                hint: root.compose-hint;
            }
        }
    }
}
