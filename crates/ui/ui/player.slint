import { Theme } from "theme.slint";
import { StreamItem, ChatMsg } from "types.slint";
import { ChatLine } from "components.slint";

// The chat lines, newest at the bottom. Older ones are pushed up and clipped at the top.
component ChatList inherits Rectangle {
    in property <[ChatMsg]> chat;
    clip: true;
    // The block is as tall as its lines and sits on the bottom edge. A layout with `alignment: end`
    // would let a full list spill past the bottom instead, hiding the newest lines.
    block := VerticalLayout {
        x: 0px;
        width: root.width;
        height: self.preferred-height;
        y: root.height - self.height;
        spacing: 8px;
        for m in root.chat : ChatLine {
            msg: m;
            line-w: root.width;
        }
    }
}

// One row of the player menu: what it changes on the left, its value between arrows on the right.
component MenuRow inherits Rectangle {
    in property <string> title;
    in property <string> value;
    in property <bool> focused;
    // Cannot be changed right now (Quality while audio only is on): no arrows, dimmed value.
    in property <bool> locked: false;
    // An action row (Subscribe): no value and no arrows, A runs it.
    in property <bool> action: false;

    height: Theme.menu-row-h;
    border-radius: 6px;
    background: root.focused ? Theme.surface-high : transparent;
    border-width: 2px;
    border-color: root.focused ? Theme.accent-light : transparent;
    animate border-color, background { duration: Theme.t-fast; }

    HorizontalLayout {
        padding-left: 16px;
        padding-right: 16px;
        spacing: 16px;
        Text {
            text: root.title;
            color: Theme.text;
            font-size: Theme.fs-body;
            font-weight: 700;
            vertical-alignment: center;
            overflow: elide;
        }
        Text {
            text: root.action ? (root.focused ? "Press A" : "") : root.focused && !root.locked ? "◀  " + root.value + "  ▶" : root.value;
            color: root.focused && !root.locked ? Theme.accent-light : Theme.muted;
            opacity: root.locked ? 0.6 : 1.0;
            font-size: Theme.fs-body;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
}

// What audio only shows instead of the video: a small, dim block of the channel, its title and
// thumbnail on black, which glides to a new spot every 30 s. Like a screensaver, no pixel stays lit
// long enough to burn in, and nothing is redrawn between glides (a constant animation would redraw
// at full frame rate, costing more battery than skipping the video saves). Black pixels are off
// on an OLED Deck.
component AudioWatermark inherits Rectangle {
    in property <StreamItem> stream;
    // The part of the parent the block may use: chat covers the rest.
    in property <length> area-w;
    in property <length> area-h;
    // Show the darkened thumbnail next to the text, when there is one.
    in property <bool> show-thumbnail: true;

    // Moves so far. Each spot comes from an R2 sequence: spread out like random ones, but with no
    // randomness, and never close to the previous spot.
    property <int> step: 0;
    property <float> fx: mod(0.5 + root.step * 0.7548777, 1.0);
    property <float> fy: mod(0.5 + root.step * 0.5698403, 1.0);
    property <length> margin: 32px;

    glide := Timer {
        interval: 30s;
        running: true;
        triggered => { root.step += 1; }
    }

    block := Rectangle {
        width: block-layout.preferred-width;
        height: block-layout.preferred-height;
        x: root.margin + root.fx * max(0px, root.area-w - 2 * root.margin - self.width);
        y: root.margin + root.fy * max(0px, root.area-h - Theme.hints-h - 2 * root.margin - self.height);
        animate x, y { duration: 3s; easing: ease-in-out; }

        block-layout := HorizontalLayout {
            spacing: 20px;
            if root.show-thumbnail && root.stream.thumb-url != "" : Rectangle {
                width: 160px;
                height: 90px;
                border-radius: 8px;
                clip: true;
                opacity: 0.28;
                Image {
                    width: parent.width;
                    height: parent.height;
                    source: root.stream.thumbnail;
                    image-fit: cover;
                }
            }
            VerticalLayout {
                alignment: center;
                spacing: 6px;
                // The stream's tint, the only colour on screen.
                Rectangle {
                    width: 48px;
                    height: 3px;
                    border-radius: 1.5px;
                    background: root.stream.tint;
                    opacity: 0.7;
                }
                Text {
                    text: root.stream.channel;
                    color: #ffffff40;
                    font-size: Theme.fs-display;
                    font-weight: 800;
                }
                Text {
                    text: root.stream.title;
                    color: #ffffff26;
                    font-size: Theme.fs-body;
                    overflow: elide;
                    max-width: 520px;
                }
                Text {
                    text: "♪  Audio only";
                    color: #ffffff26;
                    font-size: Theme.fs-small;
                    letter-spacing: 2px;
                }
            }
        }
    }
}

// Chat is a side panel (the video shrinks to make room) or an overlay (lines over the video).
export component PlayerScreen inherits Rectangle {
    in property <StreamItem> stream;
    in property <[ChatMsg]> chat;
    in property <bool> chat-open;
    // Overlay layout instead of the side panel (the `chat_layout` setting).
    in property <bool> chat-overlay: false;
    // Connection state to show next to the chat ("Connecting…"), empty when all is well.
    in property <string> chat-status: "";
    // The latest video frame (a GL texture rendered by mpv).
    in property <image> video;
    // 0 loading, 1 playing, 2 offline, 3 failed (PlaybackId in view_model.rs).
    in property <int> playback: 0;
    in property <string> playback-error: "";
    // The player's last log lines before the failure, one per line.
    in property <string> playback-details: "";
    in property <bool> paused: false;
    in property <bool> hud-visible: true;
    // The player menu (Start): open, its focused row and the value of each row (PlayerMenuRow
    // order in htpc-core: quality, hardware decoding, latency, zoom, stats, audio only, sleep).
    in property <bool> menu-open: false;
    in property <int> menu-focus: 0;
    in property <[string]> menu-values: [];
    // Sound only: a black screen with a drifting watermark instead of the video.
    in property <bool> audio-only: false;
    // The stats box, one fact per line. Empty hides it.
    in property <string> stats-text: "";
    // The sleep timer next to the channel name ("Sleep in 42 min"). Empty without one.
    in property <string> sleep-label: "";
    // The subscribe card (player menu): open, the page's QR code (one pixel per module, with its
    // quiet zone), its address to type, and whether A opens it in a browser (not in Game Mode).
    in property <bool> subscribe-open: false;
    in property <image> subscribe-qr;
    in property <string> subscribe-url: "";
    in property <bool> subscribe-can-open: false;
    // The index of the Subscribe row, the only action row (PlayerMenuRow::Subscribe).
    property <int> subscribe-row: 7;
    property <[string]> menu-titles: ["Quality", "Hardware decoding", "Latency", "Zoom", "Stats", "Audio only", "Sleep timer", "Subscribe to " + root.stream.channel];
    // What each row does, shown under the rows for the focused one. Same order as the titles.
    property <[string]> menu-help: [
        "Picture quality. Lower uses less data and battery. Reloads the stream.",
        "Decode on the graphics chip. Turn off if the picture stutters or shows glitches.",
        "Low stays close to live. Normal buffers more, for fewer stalls on weak Wi-Fi. Reloads the stream.",
        "Fit shows the whole picture with black bars. Fill crops it to fill the screen.",
        "A box with resolution, codec, bitrate, buffer and dropped frames.",
        "Sound only, on a dark screen. Saves data and battery. For this stream only.",
        "Stops the stream and puts the device to sleep after a while. Asks a minute before.",
        "Shows a QR code of the channel's subscribe page, to finish on your phone.",
    ];

    // Skeleton pulse, 0..1 (only ticks while a skeleton is shown).
    property <float> pulse: 0.5 + 0.5 * Math.sin(mod(animation-tick() / Theme.t-pulse, 1) * 360deg);

    Rectangle {
        // Slint centres a child that is smaller than its parent unless x and y are set, which
        // would push the video to the right while the side panel is open.
        x: 0px;
        y: 0px;
        width: parent.width - (root.chat-open && !root.chat-overlay ? Theme.chat-w : 0px);
        height: parent.height;
        animate width { duration: Theme.t-med; easing: ease-out; }
        background: #000000;
        clip: true;

        Image {
            width: parent.width;
            height: parent.height;
            source: root.video;
            image-fit: fill;
            // mpv sends no frames in audio only, but the texture may still hold the last one.
            visible: root.playback == 1 && !root.audio-only;
        }

        // Audio only: pure black, and the watermark keeps clear of an open chat overlay (the side
        // panel already narrows this rectangle).
        if root.playback == 1 && root.audio-only : AudioWatermark {
            width: parent.width;
            height: parent.height;
            stream: root.stream;
            area-w: parent.width - (root.chat-open && root.chat-overlay ? Theme.chat-overlay-w : 0px);
            area-h: parent.height;
        }

        // Loading: the stream's tint, pulsing, until the first frame. Created only while loading,
        // so the pulse's animation clock does not keep the window redrawing afterwards.
        if root.playback == 0 : Rectangle {
            background: @linear-gradient(135deg, root.stream.tint, #000000);
            opacity: 0.55 + 0.45 * root.pulse;
        }
        Text {
            visible: root.playback == 0;
            text: root.audio-only ? "Starting audio…" : "Starting stream…";
            color: Theme.text;
            font-size: Theme.fs-body;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        // End screen: the channel is not live (any more), or the stream could not start.
        Rectangle {
            visible: root.playback == 2 || root.playback == 3;
            background: @linear-gradient(135deg, root.stream.tint, #000000);
            VerticalLayout {
                alignment: center;
                spacing: 12px;
                padding: 48px;
                Text {
                    text: root.playback == 2 ? root.stream.channel + " is offline" : "Could not start the stream";
                    color: Theme.text;
                    font-size: Theme.fs-display;
                    font-weight: 800;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                // The app looks for the stream again every 10 s (OFFLINE_RECHECK in the app's
                // playback.rs) and plays it as soon as it is back, e.g. after a 24 h restart.
                Text {
                    visible: root.playback == 2;
                    text: "Checking every 10 seconds, it will play as soon as it is back";
                    color: Theme.muted;
                    font-size: Theme.fs-body;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                Text {
                    visible: root.playback == 3;
                    text: root.playback-error;
                    color: Theme.muted;
                    font-size: Theme.fs-body;
                    horizontal-alignment: center;
                    wrap: word-wrap;
                }
                // What mpv (or Streamlink) said, left-aligned on a dark panel so a photo of the
                // screen can be read.
                if root.playback == 3 && root.playback-details != "" : Rectangle {
                    background: #000000a0;
                    border-radius: 8px;
                    VerticalLayout {
                        padding: 16px;
                        Text {
                            text: root.playback-details;
                            color: Theme.text;
                            font-size: Theme.fs-small;
                            wrap: word-wrap;
                        }
                    }
                }
                Text {
                    text: "Press A or X to try again  ·  B to go back";
                    color: Theme.accent-light;
                    font-size: Theme.fs-body;
                    horizontal-alignment: center;
                }
            }
        }

        // Paused badge.
        Rectangle {
            visible: root.playback == 1 && root.paused;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 120px;
            height: 120px;
            border-radius: 60px;
            background: #000000a0;
            Text {
                text: "❚❚";
                color: Theme.text;
                font-size: 44px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
        }

        // Stats box ("nerds view"): top left, over the video, on every stream until turned off.
        // While the menu is open it moves to the menu's right, as the menu is tall enough to
        // cover it, and narrows if the chat panel leaves less room.
        if root.stats-text != "" : Rectangle {
            x: Theme.safe-x / 2 + (root.menu-open ? Theme.menu-w + 16px : 0px);
            y: 24px;
            width: min(Theme.stats-w, parent.width - self.x - 16px);
            height: stats-layout.preferred-height;
            background: #000000b8;
            border-radius: 8px;
            stats-layout := VerticalLayout {
                padding: 14px;
                Text {
                    text: root.stats-text;
                    color: Theme.text;
                    font-size: Theme.fs-small;
                    wrap: word-wrap;
                }
            }
        }

        // Player menu: bottom left, just above the HUD text. Up/Down pick a row, Left/Right change
        // it (see `player_menu_intent` in htpc-core).
        if root.menu-open : Rectangle {
            x: Theme.safe-x / 2;
            y: parent.height - 190px - self.height - 8px;
            width: Theme.menu-w;
            height: menu-layout.preferred-height;
            background: #18181bf0;
            border-radius: 10px;
            border-width: 1px;
            border-color: Theme.surface-high;
            menu-layout := VerticalLayout {
                padding: 12px;
                spacing: 4px;
                Text {
                    text: "OPTIONS";
                    color: Theme.accent-light;
                    font-size: Theme.fs-small;
                    font-weight: 800;
                    letter-spacing: 3px;
                }
                for title[i] in root.menu-titles : MenuRow {
                    title: title;
                    value: root.menu-values[i];
                    focused: root.menu-focus == i;
                    locked: i == 0 && root.audio-only;
                    action: i == root.subscribe-row;
                }
                Text {
                    text: root.menu-focus == 0 && root.audio-only ? "Locked while Audio only is on." : root.menu-help[root.menu-focus];
                    color: Theme.text;
                    font-size: Theme.fs-small;
                    wrap: word-wrap;
                }
                Text {
                    text: "Not saved: lasts until LiveDeck quits";
                    color: Theme.muted;
                    font-size: Theme.fs-small;
                }
            }
        }

        // HUD: channel, title and viewers. Fades out on its own while playing, never while the
        // menu is open.
        Rectangle {
            y: parent.height - 190px;
            height: 190px;
            opacity: (root.hud-visible || root.menu-open || root.playback != 1 || root.paused) ? 1.0 : 0.0;
            animate opacity { duration: Theme.t-med; }
            background: @linear-gradient(180deg, #00000000, #000000d0);

            VerticalLayout {
                padding-left: Theme.safe-x;
                padding-right: Theme.safe-x;
                padding-bottom: Theme.hints-h + 8px;
                alignment: end;
                spacing: 4px;

                HorizontalLayout {
                    alignment: start;
                    spacing: 16px;
                    Text {
                        text: root.stream.channel;
                        color: Theme.text;
                        font-size: Theme.fs-title;
                        font-weight: 800;
                        vertical-alignment: center;
                    }
                    // Fades with the rest of the HUD, and any button shows it again.
                    if root.sleep-label != "" : Rectangle {
                        width: sleep-text.preferred-width + 20px;
                        height: sleep-text.preferred-height + 8px;
                        y: (parent.height - self.height) / 2;
                        border-radius: self.height / 2;
                        background: #ffffff1f;
                        sleep-text := Text {
                            text: root.sleep-label;
                            color: Theme.text;
                            font-size: Theme.fs-small;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                    }
                }
                Text {
                    text: root.stream.title + "  ·  " + root.stream.viewers;
                    color: Theme.muted;
                    font-size: Theme.fs-small;
                    overflow: elide;
                }
            }
        }

        // Subscribe card: over the video (and the menu) on a dark scrim, while the stream plays
        // on. Chat is left as it is. The QR code is drawn like the sign-in screen's. The scrim
        // swallows clicks; the hints bar has the buttons.
        if root.subscribe-open : Rectangle {
            background: #000000b8;
            TouchArea { }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - Theme.hints-h - self.height) / 2;
                width: 440px;
                height: card-layout.preferred-height;
                border-radius: 12px;
                border-width: 2px;
                border-color: Theme.surface-high;
                background: Theme.surface;

                card-layout := VerticalLayout {
                    padding: 32px;
                    spacing: 14px;
                    alignment: center;
                    Text {
                        text: "Subscribe to " + root.stream.channel;
                        color: Theme.text;
                        font-size: Theme.fs-title;
                        font-weight: 800;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                    Text {
                        text: "Scan to subscribe on your phone";
                        color: Theme.muted;
                        font-size: Theme.fs-body;
                        horizontal-alignment: center;
                    }
                    HorizontalLayout {
                        alignment: center;
                        Rectangle {
                            width: 240px;
                            height: 240px;
                            background: #ffffff;
                            border-radius: 8px;
                            clip: true;
                            Image {
                                width: parent.width;
                                height: parent.height;
                                source: root.subscribe-qr;
                                image-fit: contain;
                                image-rendering: pixelated;
                            }
                        }
                    }
                    Text {
                        text: root.subscribe-url;
                        color: Theme.accent-light;
                        font-size: Theme.fs-body;
                        font-weight: 700;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }

    // Side panel: slides in from the right, over the strip the video made room for.
    if !root.chat-overlay : Rectangle {
        x: parent.width - (root.chat-open ? Theme.chat-w : 0px);
        width: Theme.chat-w;
        height: parent.height;
        background: Theme.surface;
        clip: true;
        animate x { duration: Theme.t-med; easing: ease-out; }

        VerticalLayout {
            padding: Theme.chat-pad;
            padding-bottom: Theme.hints-h + 8px;
            spacing: 12px;

            HorizontalLayout {
                Text {
                    text: "CHAT";
                    color: Theme.accent-light;
                    font-size: Theme.fs-small;
                    font-weight: 800;
                    letter-spacing: 3px;
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: root.chat-status;
                    color: Theme.muted;
                    font-size: Theme.fs-small;
                }
            }
            ChatList {
                chat: root.chat;
                vertical-stretch: 1;
            }
        }
    }

    // Overlay: lines over the right of the video on a soft scrim, above the hints bar. It fades
    // in and out, and the video keeps its full size.
    if root.chat-overlay : Rectangle {
        x: parent.width - Theme.chat-overlay-w;
        width: Theme.chat-overlay-w;
        height: parent.height;
        opacity: root.chat-open ? 1.0 : 0.0;
        animate opacity { duration: Theme.t-med; }
        background: @linear-gradient(90deg, #00000000, #000000b0);

        VerticalLayout {
            padding: Theme.chat-pad;
            padding-bottom: Theme.hints-h + 8px;
            spacing: 8px;

            Text {
                text: root.chat-status;
                color: Theme.muted;
                font-size: Theme.fs-small;
                horizontal-alignment: right;
            }
            ChatList {
                chat: root.chat;
                vertical-stretch: 1;
            }
        }
    }
}
