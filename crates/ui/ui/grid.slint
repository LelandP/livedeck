import { Theme } from "theme.slint";
import { RowData } from "types.slint";
import { StreamCard } from "components.slint";

// Browse and Category screens: a grid that scrolls vertically. The focused row slides to the top
// anchor, so the next row peeks in below it and the user can see more is coming.
export component GridContent inherits Rectangle {
    in property <[RowData]> rows;
    in property <int> sel-row;
    in property <int> sel-col;
    in property <bool> active;
    in property <string> heading;
    callback picked(int, int);
    clip: true;

    // Pitch of one grid row. All rows of a grid share a card shape.
    property <length> pitch: Theme.grid-row-height(root.rows.length > 0 ? root.rows[0].shape : 0);

    Rectangle {
        y: Theme.grid-top - root.sel-row * root.pitch;
        animate y { duration: Theme.t-med; easing: ease-out; }

        for r[ri] in root.rows : Rectangle {
            y: ri * root.pitch;
            height: root.pitch;
            opacity: ri == root.sel-row ? 1.0 : 0.6;
            animate opacity { duration: Theme.t-med; }

            for item[ci] in r.items : StreamCard {
                x: Theme.safe-x - 24px + ci * Theme.slot-width(r.shape);
                item: item;
                shape: r.shape;
                focused: root.active && ri == root.sel-row && ci == root.sel-col && !item.loading;
                dimmed: ri != root.sel-row;
                clicked => { root.picked(ri, ci); }
            }
        }
    }

    // The heading sits on a solid strip so rows scrolling up pass underneath it.
    Rectangle {
        height: Theme.grid-top - 20px;
        background: Theme.bg;
        Text {
            x: Theme.safe-x - 24px;
            y: 36px;
            text: root.heading;
            color: Theme.text;
            font-size: Theme.fs-display;
            font-weight: 900;
        }
    }
}
