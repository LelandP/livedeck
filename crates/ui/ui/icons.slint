// The View button's icon (Steam Deck and Xbox): two overlapping boxes, outlined.
export component ViewIcon inherits Path {
    in property <color> tone: Theme.text;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: "M8 3h13v13H8zM3 8h13v13H3z";
    fill: transparent;
    stroke: root.tone;
    stroke-width: 2.4px;
}

import { Theme } from "theme.slint";

// A padlock, for subscriber-only videos: the body, and the shackle above it.
export component LockIcon inherits Path {
    in property <color> tone: Theme.text;
    width: 18px;
    height: 18px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: "M5 11h14v10H5zM8 11V7a4 4 0 0 1 8 0v4";
    fill: transparent;
    stroke: root.tone;
    stroke-width: 2.4px;
}

// Vector nav icons (24x24 viewbox) so no image assets are needed.
// kind (RailEntry order): 0 home, 1 following (heart), 2 favorites (star), 3 browse (grid),
// 4 search (magnifier), 5 settings (sliders), 6 account
export component NavIcon inherits Path {
    in property <int> kind;
    width: 28px;
    height: 28px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.kind == 0 ? "M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"
        : root.kind == 1 ? "M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
        : root.kind == 2 ? "M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"
        : root.kind == 3 ? "M3 3h8v8H3zM13 3h8v8h-8zM3 13h8v8H3zM13 13h8v8h-8z"
        : root.kind == 4 ? "M15.5 14h-.79l-.28-.27A6.47 6.47 0 0 0 16 9.5 6.5 6.5 0 1 0 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z"
        : root.kind == 5 ? "M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"
        : "M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z";
}
