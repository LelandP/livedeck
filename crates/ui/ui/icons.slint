// Vector nav icons (24x24 viewbox) so no image assets are needed.
// kind: 0 home, 1 following (heart), 2 browse (grid), 3 settings (sliders), 4 account
export component NavIcon inherits Path {
    in property <int> kind;
    width: 28px;
    height: 28px;
    viewbox-width: 24;
    viewbox-height: 24;
    commands: root.kind == 0 ? "M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z"
        : root.kind == 1 ? "M12 21.35l-1.45-1.32C5.4 15.36 2 12.28 2 8.5 2 5.42 4.42 3 7.5 3c1.74 0 3.41.81 4.5 2.09C13.09 3.81 14.76 3 16.5 3 19.58 3 22 5.42 22 8.5c0 3.78-3.4 6.86-8.55 11.54L12 21.35z"
        : root.kind == 2 ? "M3 3h8v8H3zM13 3h8v8h-8zM3 13h8v8H3zM13 13h8v8h-8z"
        : root.kind == 3 ? "M3 17v2h6v-2H3zM3 5v2h10V5H3zm10 16v-2h8v-2h-8v-2h-2v6h2zM7 9v2H3v2h4v2h2V9H7zm14 4v-2H11v2h10zm-6-4h2V7h4V5h-4V3h-2v6z"
        : "M12 12c2.21 0 4-1.79 4-4s-1.79-4-4-4-4 1.79-4 4 1.79 4 4 4zm0 2c-2.67 0-8 1.34-8 4v2h16v-2c0-2.66-5.33-4-8-4z";
}
