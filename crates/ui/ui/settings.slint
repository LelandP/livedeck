import { Theme } from "theme.slint";

// One focusable row: a title with a line of help on the left and the current value on the right.
// A choice shows arrows around its value, because Left and Right step through the values.
component SettingRow inherits Rectangle {
    in property <string> title;
    in property <string> help;
    in property <string> value;
    in property <bool> focused;
    in property <bool> choice: false;

    // Six rows and the about lines fit above the hints bar at 800 px; more scroll (`SettingsScreen`).
    height: 74px;
    max-width: 720px;
    background: Theme.surface;
    border-radius: 8px;
    border-width: 4px;
    border-color: root.focused ? Theme.accent-light : transparent;
    animate border-color { duration: Theme.t-fast; }

    HorizontalLayout {
        padding-left: 32px;
        padding-right: 32px;
        spacing: 24px;

        VerticalLayout {
            alignment: center;
            spacing: 4px;
            Text {
                text: root.title;
                color: Theme.text;
                font-size: Theme.fs-title;
                font-weight: 800;
                overflow: elide;
            }
            Text {
                text: root.help;
                color: Theme.muted;
                font-size: Theme.fs-small;
                overflow: elide;
            }
        }

        Text {
            text: root.choice ? "◀  " + root.value + "  ▶" : root.value;
            color: root.focused ? Theme.accent-light : Theme.text;
            font-size: Theme.fs-body;
            font-weight: 700;
            vertical-alignment: center;
            horizontal-alignment: right;
        }
    }
}

// Settings: account, chat layout, stream quality and the about text. The focused row is chosen in
// Rust (`SettingsRow` in htpc-core); this file only draws it.
export component SettingsScreen inherits Rectangle {
    // Empty while signed out.
    in property <string> user-name;
    in property <string> chat-layout;
    in property <string> quality;
    in property <string> live-notifications;
    in property <string> background-play;
    in property <string> show-kick;
    in property <string> caption-size;
    in property <string> caption-position;
    in property <string> caption-background;
    in property <string> version;
    // 0 account, 1 chat layout, 2 quality, 3 live notifications, 4 background play, 5 show Kick,
    // 6 caption size, 7 caption position, 8 caption background (SettingsRow order). -1 while the
    // rail has focus.
    in property <int> focus-row;

    VerticalLayout {
        padding-left: Theme.safe-x - 24px;
        padding-right: Theme.safe-x;
        padding-top: 36px;
        padding-bottom: Theme.hints-h;
        spacing: 12px;

        Text {
            text: "Settings";
            color: Theme.text;
            font-size: Theme.fs-display;
            font-weight: 900;
        }

        // The rows scroll when they don't all fit (the Deck's 800 px), keeping the focused one and
        // a bit of the next in view. On a taller screen they all show and nothing moves.
        rows-view := Rectangle {
            vertical-stretch: 1;
            clip: true;
            property <length> step: 74px + 12px;
            property <length> spill: max(0px, rows.preferred-height - self.height);
            property <length> want: (max(0, root.focus-row) + 1.5) * self.step - self.height;
            property <length> scroll: max(0px, min(self.spill, self.want));

        rows := VerticalLayout {
            y: -rows-view.scroll;
            width: rows-view.width;
            height: self.preferred-height;
            spacing: 12px;
            alignment: start;
            animate y { duration: Theme.t-fast; easing: ease-out; }

        SettingRow {
            title: root.user-name == "" ? "Not signed in" : root.user-name;
            help: root.user-name == "" ? "Sign in to Twitch to see who you follow" : "Signed in to Twitch";
            value: root.user-name == "" ? "Sign in" : "Sign out";
            focused: root.focus-row == 0;
        }
        SettingRow {
            title: "Chat";
            help: "Where chat appears while you watch";
            value: root.chat-layout;
            choice: true;
            focused: root.focus-row == 1;
        }
        SettingRow {
            title: "Video quality";
            help: "Applies to the next stream you open";
            value: root.quality;
            choice: true;
            focused: root.focus-row == 2;
        }
        SettingRow {
            title: "Live notifications";
            help: root.user-name == "" ? "Sign in to Twitch to hear when channels you follow go live" : "A popup when a channel you follow goes live";
            value: root.live-notifications;
            choice: true;
            focused: root.focus-row == 3;
        }
        SettingRow {
            title: "Play in the background";
            help: "Keep the stream playing when you switch to another app";
            value: root.background-play;
            choice: true;
            focused: root.focus-row == 4;
        }
        SettingRow {
            title: "Show Kick";
            help: "Kick streams next to Twitch, on Home and in Search";
            value: root.show-kick;
            choice: true;
            focused: root.focus-row == 5;
        }
        SettingRow {
            title: "Caption size";
            help: "How big generated captions are drawn";
            value: root.caption-size;
            choice: true;
            focused: root.focus-row == 6;
        }
        SettingRow {
            title: "Caption position";
            help: "Top keeps them clear of a stream's own text at the bottom";
            value: root.caption-position;
            choice: true;
            focused: root.focus-row == 7;
        }
        SettingRow {
            title: "Caption background";
            help: "The box behind them. None outlines the text instead";
            value: root.caption-background;
            choice: true;
            focused: root.focus-row == 8;
        }
        }
        }

        Text {
            text: "LiveDeck " + root.version + "  ·  Unofficial. Not affiliated with Twitch or Valve.";
            color: Theme.muted;
            font-size: Theme.fs-small;
        }
        Text {
            text: "Streams are resolved with Streamlink and may break or conflict with Twitch's terms.";
            color: Theme.muted;
            font-size: Theme.fs-small;
        }
    }
}
