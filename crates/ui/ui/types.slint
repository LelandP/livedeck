// One stream of the *Resume multiview* card's 2×2 mosaic.
export struct MosaicCell {
    tint: color,
    thumbnail: image,
    // Cache key of the preview. Rust uses it to patch the image in place.
    thumb-url: string,
}

export struct StreamItem {
    channel: string,
    title: string,
    category: string,
    viewers: string,
    // Placeholder shown until the thumbnail has loaded (and when there is none).
    tint: color,
    thumbnail: image,
    // Cache key of the thumbnail. Rust uses it to patch the image into the card in place.
    thumb-url: string,
    // A skeleton card: a pulsing placeholder for data that has not arrived yet.
    loading: bool,
    // The "press X to retry" card at the end of a row whose next page failed.
    retry: bool,
    // A followed channel that is not live: dimmed, labelled "Offline".
    offline: bool,
    // A Kick channel: a "Kick" chip at the top left. Twitch cards have none.
    kick: bool,
    // Picked for multiview: a tick badge at the top right.
    picked: bool,
    // Home's *Resume multiview* card: the mosaic instead of the thumbnail, and `title` ("5
    // streams") always shown.
    resume: bool,
    mosaic: [MosaicCell],
}

// A "<channel> is live" popup (live notifications), or a note ("2 offline, skipped").
export struct ToastItem {
    // Rust keeps each popup's element by this, so its animations and timer carry on.
    id: int,
    // The channel, or a note's whole text.
    name: string,
    // A note: `name` alone, without "is live", a preview or the second line.
    note: bool,
    // The stream title and category.
    line: string,
    // Shown until the preview has loaded (and when there is none).
    tint: color,
    thumbnail: image,
    // Cache key of the preview. Rust uses it to patch the image in place.
    thumb-url: string,
}

// One key of the Search keyboard: where it sits on the 10-column grid and how many columns it
// covers (htpc_core::keyboard).
export struct SearchKey {
    label: string,
    row: int,
    col: int,
    span: int,
}

export struct RowData {
    title: string,
    items: [StreamItem],
    // Card shape of the row: 0 landscape, 1 portrait (box art), 2 hero (one wide card).
    shape: int,
}

// One word of a chat line, an emote or a badge. Slint `Text` is single-style, so a line is a row
// of these (see ChatLine) and the images are patched in as they download, like card thumbnails.
export struct ChatPiece {
    // A word, or the name of an emote (shown until its image has arrived). Empty for badges.
    text: string,
    image: image,
    // Cache key of the image. Rust uses it to patch the image in place. Empty for plain words.
    url: string,
    emote: bool,
}

// One place of the multiview grid: a stream, or an empty *Add a stream* slot. Where it sits is in
// the 1280x800 layout's pixels (htpc_core::layout::rects); the screen scales and centres it.
export struct MvTile {
    x: float,
    y: float,
    w: float,
    h: float,
    // An *Add a stream* slot: everything below is unused.
    empty: bool,
    // The player it plays on: its frames are `tile-videos[slot]`.
    slot: int,
    channel: string,
    // "Twitch · Just Chatting · 4.2K watching".
    line: string,
    kick: bool,
    tint: color,
    // The rendition it plays ("480p"), and whether the network limit lowered it (drawn amber).
    quality: string,
    lowered: bool,
    // The stream with sound: a violet badge with a level meter, never dimmed.
    sound: bool,
    focused: bool,
    // 0 loading, 1 playing, 2 offline, 3 failed (PlaybackId in view_model.rs).
    state: int,
    // What A does on the focused tile ("Listen", "Full screen", "Add a stream").
    action: string,
}

// A layout chip in the multiview header: "2" ... "9", "Spotlight".
export struct MvLayoutChip {
    label: string,
    on: bool,
    // Too small for the streams: LB/RB skip it, and it is drawn faded.
    fits: bool,
}

// A stream in the strip shown over full screen on LB/RB.
export struct MvStripItem {
    slot: int,
    channel: string,
    kick: bool,
    // The one on screen (with sound).
    on: bool,
}

// A row of the View popup: what it does, and a value on the right (the layout row's "◀ Grid of 4 ▶").
export struct PopupItem {
    label: string,
    value: string,
}

export struct ChatMsg {
    user: string,
    // Name colour (and the whole line's colour for /me).
    tint: color,
    // 0 message ("name: text"), 1 action (/me: all in the chatter's colour), 2 notice (no name).
    kind: int,
    badges: [ChatPiece],
    pieces: [ChatPiece],
}
